{
  "name": "sloanalytica-public-data",
  "private": true,
  "version": "1.0.0",
  "description": "公開MachineDataの読み取り専用監査ツール",
  "scripts": {
    "audit": "node tools/audit-public-data.mjs",
    "audit:report": "node tools/audit-public-data.mjs --json-out reports/audit-report.json",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "research:validate": "node tools/validate-research-data.mjs",
    "stats:evaluate": "node tools/evaluate-research-statistics.mjs",
    "machine:build": "node tools/build-machine-data.mjs",
    "selection:validate": "node tools/validate-selection-data.mjs",
    "machine:new": "node tools/new-machine-workflow.mjs",
    "machine:publish": "node tools/publish-machine-data.mjs",
    "sources:watch": "node tools/watch-research-sources.mjs",
    "registry:validate": "node tools/validate-machine-registry.mjs machine-registry.json",
    "registry:sync": "node tools/sync-machine-registry.mjs",
    "machines:status": "node tools/machine-registry-status.mjs",
    "market:validate": "node tools/validate-market-snapshot.mjs market-snapshot.json",
    "market:merge": "node tools/merge-market-snapshot.mjs",
    "market:presence:validate": "node tools/validate-market-presence-snapshot.mjs market-presence-snapshot.json",
    "market:presence:merge": "node tools/merge-market-presence.mjs",
    "market:priority": "node tools/market-priority-report.mjs",
    "candidate:validate": "node tools/validate-machine-candidate-assessment.mjs machine-candidate-assessment.json",
    "machines:research-queue": "node tools/machine-research-queue.mjs",
    "machines:score": "node tools/machine-candidate-score.mjs"
  }
}
