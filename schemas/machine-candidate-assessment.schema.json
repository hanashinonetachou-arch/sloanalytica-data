{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "policy",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "machine-candidate-assessment-v1"
    },
    "generatedAt": {
      "type": "string"
    },
    "policy": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "marketKey",
          "displayName",
          "marketScore",
          "researchReadiness",
          "platformFit",
          "estimatedWorkload",
          "settingInferenceValue",
          "assessmentStatus"
        ],
        "properties": {
          "marketKey": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "registryMachineId": {
            "type": [
              "string",
              "null"
            ]
          },
          "marketScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "researchReadiness": {
            "enum": [
              "UNKNOWN",
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "platformFit": {
            "enum": [
              "UNKNOWN",
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "estimatedWorkload": {
            "enum": [
              "UNKNOWN",
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "settingInferenceValue": {
            "enum": [
              "UNKNOWN",
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "assessmentStatus": {
            "enum": [
              "MARKET_ONLY",
              "RESEARCHED",
              "READY",
              "HOLD"
            ]
          },
          "lastAssessedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
