{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloanalytica.example/schemas/research-data.schema.json",
  "title": "SloAnalytica ResearchData v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "machine",
    "researchedAt",
    "sources",
    "features",
    "evidenceCandidates",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "research-data-v1"
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineId",
        "displayName",
        "manufacturer",
        "settings",
        "identitySourceRefs"
      ],
      "properties": {
        "machineId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "formalName": {
          "type": "string"
        },
        "modelNumber": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "introductionDate": {
          "type": "string",
          "format": "date"
        },
        "settings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SET_[A-Za-z0-9_]+$"
          }
        },
        "identitySourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "researchedAt": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "evidenceCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "publisher",
        "url",
        "checkedAt",
        "sourceType"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "sourceType": {
          "enum": [
            "official",
            "major_analysis",
            "industry",
            "other"
          ]
        }
      }
    },
    "settingValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability"
      ],
      "properties": {
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rawDisplay": {
          "type": "string"
        },
        "numerator": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "denominator": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researchFeatureId",
        "name",
        "factStatus",
        "candidateModel",
        "trialUnit",
        "numeratorDefinition",
        "denominatorDefinition",
        "settingValues",
        "sourceRefs",
        "crossSourceStatus"
      ],
      "properties": {
        "researchFeatureId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "factStatus": {
          "enum": [
            "verified",
            "pending",
            "conflict",
            "rejected"
          ]
        },
        "candidateModel": {
          "enum": [
            "binomial",
            "multinomial",
            "poisson",
            "unknown"
          ]
        },
        "trialUnit": {
          "type": "string",
          "minLength": 1
        },
        "observationScope": {
          "type": "string"
        },
        "numeratorDefinition": {
          "type": "string",
          "minLength": 1
        },
        "denominatorDefinition": {
          "type": "string",
          "minLength": 1
        },
        "settingValues": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/settingValue"
          }
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "crossSourceStatus": {
          "enum": [
            "single_source",
            "matched",
            "rounded_match",
            "conflict"
          ]
        },
        "sourceWording": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "settingDistributions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "distributionMode": {
          "enum": [
            "complete",
            "implicit_residual"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researchEvidenceId",
        "name",
        "factStatus",
        "allowedSettings",
        "deniedSettings",
        "sourceRefs"
      ],
      "properties": {
        "researchEvidenceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "factStatus": {
          "enum": [
            "verified",
            "pending",
            "conflict",
            "rejected"
          ]
        },
        "allowedSettings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "deniedSettings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sourceWording": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictId",
        "targetType",
        "targetId",
        "description",
        "sourceRefs",
        "resolutionStatus"
      ],
      "properties": {
        "conflictId": {
          "type": "string",
          "minLength": 1
        },
        "targetType": {
          "enum": [
            "machine",
            "feature",
            "evidence"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "resolutionStatus": {
          "enum": [
            "open",
            "resolved",
            "rejected"
          ]
        },
        "resolutionNote": {
          "type": "string"
        }
      }
    }
  }
}
