{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloanalytica.local/schemas/selection-data.schema.json",
  "title": "SloAnalytica SelectionData v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "machineId",
    "machineDataVersion",
    "inputs",
    "features"
  ],
  "properties": {
    "schemaVersion": {
      "const": "selection-data-v1"
    },
    "machineId": {
      "type": "string",
      "minLength": 1
    },
    "machineDataVersion": {
      "type": "string",
      "minLength": 1
    },
    "uiCategoryLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "category",
          "displayOrder"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^INP_[A-Z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "integer",
              "number",
              "counter",
              "boolean",
              "enum",
              "multi_enum"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer",
            "minimum": 0
          },
          "inferenceRole": {
            "enum": [
              "INCLUDE_PRIMARY",
              "INCLUDE_SUPPORT",
              "DISPLAY_ONLY"
            ]
          },
          "parentInputId": {
            "type": "string"
          },
          "options": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "researchFeatureId",
          "featureId",
          "adoptionCategory"
        ],
        "properties": {
          "researchFeatureId": {
            "type": "string"
          },
          "featureId": {
            "type": "string",
            "pattern": "^FEAT_[A-Z0-9_]+$"
          },
          "adoptionCategory": {
            "enum": [
              "INCLUDE_PRIMARY",
              "INCLUDE_SUPPORT",
              "DISPLAY_ONLY",
              "EXCLUDE"
            ]
          },
          "numeratorInputId": {
            "type": "string"
          },
          "denominatorInputId": {
            "type": "string"
          },
          "categoryInputIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minimumSample": {
            "type": "integer",
            "minimum": 0
          },
          "sampleRecommendation": {
            "type": "integer",
            "minimum": 0
          },
          "requiredTrials": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": {"type": "number", "minimum": 0},
              "unit": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "inputTransform": {
            "enum": [
              "inverse_ratio_to_trials",
              "sum_inputs_to_trials",
              "observed_ratio_to_trials"
            ]
          },
          "displayFormat": {
            "enum": [
              "ratio_1_over_n",
              "percentage",
              "count",
              "decimal"
            ]
          },
          "categorySubtractInputIds": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "trialCountInputId": {
            "type": "string"
          },
          "difficultyExposure": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "per_game",
                  "fixed_rate",
                  "setting_rate",
                  "derived_event_rate"
                ]
              },
              "factor": {
                "type": "number",
                "minimum": 0
              },
              "trialsPerGame": {
                "type": "number",
                "minimum": 0
              },
              "trialsPerGameBySetting": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "quality": {
                "enum": [
                  "EXACT",
                  "DERIVED",
                  "PROVISIONAL",
                  "ESTIMATED"
                ]
              },
              "basisId": {
                "type": "string",
                "minLength": 1
              },
              "sourceFeatureId": {
                "type": "string",
                "minLength": 1
              },
              "sourceCategoryId": {
                "type": "string",
                "minLength": 1
              },
              "eventMultiplier": {
                "type": "number",
                "minimum": 0
              },
              "confidence": {
                "enum": [
                  "HIGH",
                  "MEDIUM_HIGH",
                  "MEDIUM",
                  "LOW_MEDIUM",
                  "LOW"
                ]
              },
              "uncertaintyNote": {
                "type": "string",
                "minLength": 1
              },
              "estimationBasis": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "difficultyParticipation": {
            "enum": [
              "INCLUDE",
              "EXCLUDE"
            ]
          },
          "difficultyExclusionReason": {
            "type": "string",
            "minLength": 1
          },
          "rejectionReason": {
            "type": "string",
            "minLength": 1
          },
          "denominatorInputIds": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "residualCategoryLabel": {
            "type": "string",
            "minLength": 1
          },
          "userReason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidenceUi": {
      "type": "object",
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "groupId",
              "label",
              "selectionMode",
              "normalizationMode",
              "options"
            ],
            "properties": {
              "groupId": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "selectionMode": {
                "enum": [
                  "single",
                  "multi"
                ]
              },
              "normalizationMode": {
                "enum": [
                  "ALLOWED_SETTINGS",
                  "EXCLUDE_SETTINGS",
                  "ALLOWED_SETTINGS_INTERSECTION"
                ]
              },
              "displayOrder": {
                "type": "integer",
                "minimum": 0
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "label"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "allowedSettings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "excludedSettings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "sourceEvidenceIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "difficultyAnalysis": {
      "type": "object",
      "properties": {
        "targetGames": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "simulationsPerSetting": {
          "type": "integer",
          "minimum": 100
        },
        "seed": {
          "type": "integer"
        },
        "targetGameBasis": {
          "type": "object",
          "required": [
            "basisId",
            "label",
            "quality"
          ],
          "properties": {
            "basisId": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "quality": {
              "enum": [
                "EXACT",
                "DERIVED",
                "PROVISIONAL",
                "UNRESOLVED",
                "ESTIMATED"
              ]
            },
            "crossMachineComparable": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "calibrationAllowedExposureQualities": {
          "type": "array",
          "items": {
            "enum": [
              "EXACT",
              "DERIVED",
              "PROVISIONAL",
              "ESTIMATED"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
