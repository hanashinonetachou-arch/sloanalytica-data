{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloanalytica.local/schemas/machine-registry.schema.json",
  "title": "SloAnalytica Machine Registry v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "machines"
  ],
  "properties": {
    "schemaVersion": {
      "const": "machine-registry-v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "machineId",
          "displayName",
          "manufacturer",
          "marketStatus",
          "appStatus",
          "researchStatus",
          "fieldTestStatus",
          "priority"
        ],
        "properties": {
          "machineId": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "introducedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "marketStatus": {
            "enum": [
              "ACTIVE",
              "DECLINING",
              "UNCERTAIN",
              "RETIRED",
              "UNKNOWN"
            ]
          },
          "marketLastCheckedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "marketSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "appStatus": {
            "enum": [
              "NOT_STARTED",
              "RESEARCHING",
              "MACHINE_DATA_BUILDING",
              "FIELD_TESTING",
              "INCLUDED",
              "BLOCKED"
            ]
          },
          "researchStatus": {
            "enum": [
              "NOT_RESEARCHED",
              "RESEARCH_DATA_PRESENT",
              "NEEDS_UPDATE",
              "UNKNOWN"
            ]
          },
          "fieldTestStatus": {
            "enum": [
              "NOT_TESTED",
              "TESTING",
              "PASS",
              "NEEDS_FIX",
              "UNKNOWN"
            ]
          },
          "machineDataVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "NONE"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
