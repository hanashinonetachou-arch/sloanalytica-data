  "features": {
    "schemaVersion": "2.0.0",
    "features": [
      {
        "featureId": "FEAT_AT_INITIAL",
        "name": "AT初当り",
        "adoptionCategory": "INCLUDE_PRIMARY",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "binomial",
        "minimumSample": 1,
        "sampleRecommendation": 8000,
        "weight": 1,
        "displayFormat": "ratio_1_over_n",
        "numeratorInputId": "INP_AT_INITIAL_COUNT",
        "denominatorInputId": "INP_AT_TRIAL_GAMES",
        "probabilities": {
          "SET_1": 0.002535496957403651,
          "SET_2": 0.002628120893561104,
          "SET_3": 0.0028011204481792717,
          "SET_4": 0.0030684258975145753,
          "SET_5": 0.003434065934065934,
          "SET_6": 0.0038270187523918864
        },
        "sourceEvidenceRefs": [
          "SRC_1GEKI_MAIN",
          "SRC_NANA_SPEC",
          "SRC_DMM_SETTING"
        ],
        "selectionRationale": {
          "summary": "AT初当り確率を設定推測の主軸として使用する。",
          "adoptionReason": "設定1の1/394.4から設定6の1/261.3まで一貫した設定差があり、複数の大手解析サイトで数値が一致している。",
          "shortTermReason": "1日単位では完全判別には不足するが、通常ゲーム数の蓄積に伴って継続的に情報を得られる。",
          "longTermReason": "設定1対6でも厳格な識別目安は約1.46万Gのため単独断定は避け、他情報と組み合わせる。",
          "strengths": [
            "入力が単純",
            "全設定の公開値が複数ソースで一致",
            "高設定ほど段階的に優遇"
          ],
          "limitations": [
            "CZ成功率など複数要因を含む総合値",
            "隣接設定の識別には非常に多い試行数が必要"
          ],
          "sourceEvidenceRefs": [
            "SRC_1GEKI_MAIN",
            "SRC_NANA_SPEC",
            "SRC_DMM_SETTING"
          ]
        }
      },
      {
        "featureId": "FEAT_CZ_WITHIN_100",
        "name": "100G+α以内のCZ当選",
        "adoptionCategory": "INCLUDE_SUPPORT",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "binomial",
        "minimumSample": 1,
        "sampleRecommendation": 30,
        "weight": 0.5,
        "displayFormat": "percentage",
        "numeratorInputId": "INP_CZ_WITHIN100_COUNT",
        "denominatorInputId": "INP_CZ_CYCLE_COUNT",
        "probabilities": {
          "SET_1": 0.1958,
          "SET_2": 0.2104,
          "SET_3": 0.2315,
          "SET_4": 0.2637,
          "SET_5": 0.3196,
          "SET_6": 0.3601
        },
        "sourceEvidenceRefs": [
          "SRC_NANA_SETTING",
          "SRC_DMM_SETTING"
        ],
        "selectionRationale": {
          "summary": "朝一を除く100G+α以内のCZ当選率を補助情報として使用する。",
          "adoptionReason": "設定1の19.58%から設定6の36.01%まで大きな差があり、複数ソースで一致している。",
          "shortTermReason": "設定1対6では約56周期が厳格な識別目安で、AT初当りより少ない試行単位で差を観測できる。",
          "longTermReason": "AT初当りやCZ全体と相関するため主情報とはせず、重複影響を抑える目的でweight 0.5の補助Featureとする。",
          "strengths": [
            "設定差が大きい",
            "周期単位で観測可能"
          ],
          "limitations": [
            "朝一モードを除外する必要がある",
            "CZ全体・AT初当りと相関がある",
            "周期定義を実機で確認する必要がある"
          ],
          "sourceEvidenceRefs": [
            "SRC_NANA_SETTING",
            "SRC_DMM_SETTING"
          ]
        }
      }
    ],
    "nonAdoptedElements": [
      {
        "name": "CZ合算・CZ内訳",
        "reason": "100G+α以内CZと同じCZ発生過程を重複評価するため初回版では不採用。ResearchDataには保持。"
      },
      {
        "name": "エピソードボーナス",
        "reason": "設定差は大きいが設定1対6でも厳格な識別目安が約3.9万Gで低頻度。"
      },
      {
        "name": "リプレイ契機AT直撃",
        "reason": "設定差は大きいが極低頻度で、設定1対6でも約5.9万Gが目安。"
      },
      {
        "name": "AT終了後の引き戻し",
        "reason": "設定差はあるがAT初当りとの依存・包含関係を考慮し、初回版では重複評価を避ける。"
      },
      {
        "name": "下段リプレイ",
        "reason": "設定差が小さく、設定1対6でも約20万Gが目安。"
      },
      {
        "name": "弱チェリー契機CZ",
        "reason": "内部状態の正確な判別が必要で、当選率自体も低いため実戦入力に不向き。"
      }
    ]
  },
