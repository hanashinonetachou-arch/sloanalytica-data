  "features": {
    "schemaVersion": "2.0.0",
    "features": [
      {
        "featureId": "FEAT_ART_INITIAL_BINOMIAL",
        "name": "ART初当り",
        "adoptionCategory": "INCLUDE_PRIMARY",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "binomial",
        "numeratorInputId": "INP_ART_INITIAL_COUNT",
        "denominatorInputId": "INP_TOTAL_GAMES",
        "displayFormat": "ratio_1_over_n",
        "minimumSample": 1000,
        "sampleRecommendation": 8000,
        "probabilities": {
          "SET_1": 0.003698224852,
          "SET_2": 0.003910833007,
          "SET_3": 0.004178854994,
          "SET_4": 0.00474608448,
          "SET_5": 0.004970178926,
          "SET_6": 0.005299417064
        },
        "selectionRationale": {
          "summary": "自力で記録したART初当り回数を主推測要素として使用する。",
          "adoptionReason": "設定1の1/270.4から設定6の1/188.7まで段階的な設定差があり、実遊技中に初当りを数えられる。",
          "shortTermReason": "1,000G前後では初当り回数が少なく、大きく振れるため暫定評価となる。",
          "longTermReason": "長時間の遊技では設定間の比較材料になるが、内部状態やボーナス経由を含む総合初当りである。",
          "strengths": [
            "設定1から6まで段階的な差がある",
            "マイスロレベルに依存せず記録できる"
          ],
          "limitations": [
            "マイスロのコーラリアンモードSET数を入力しない",
            "データカウンターの集計仕様が店舗により異なる可能性がある"
          ],
          "sourceEvidenceRefs": [
            "SRC_ART_INITIAL_1GEKI",
            "SRC_ART_INITIAL_PWORLD"
          ]
        }
      },
      {
        "featureId": "FEAT_COMMON_7_BELL_BINOMIAL",
        "name": "共通7枚ベル",
        "adoptionCategory": "INCLUDE_PRIMARY",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "binomial",
        "numeratorInputId": "INP_COMMON_7_BELL_COUNT",
        "denominatorInputId": "INP_COMMON_7_BELL_INVERSE_RATE",
        "inputTransform": "inverse_ratio_to_trials",
        "displayFormat": "ratio_1_over_n",
        "minimumSample": 1000,
        "sampleRecommendation": 5000,
        "probabilities": {
          "SET_1": 0.069444444444,
          "SET_2": 0.069444444444,
          "SET_3": 0.070921985816,
          "SET_4": 0.075757575758,
          "SET_5": 0.076923076923,
          "SET_6": 0.07874015748
        },
        "selectionRationale": {
          "summary": "マイスロで確認した共通7枚ベルを主推測要素として使用する。",
          "adoptionReason": "サミー開発ボイス由来の設定別確率が確認でき、設定3と4の間を中心に実用的な差がある。",
          "shortTermReason": "短時間ではベルの偏りが大きいため、他の主推測要素と合わせて暫定的に判断する。",
          "longTermReason": "5,000G程度を目安にサンプルが増えると、低設定域と高設定域の比較材料として安定しやすい。",
          "strengths": [
            "遊技中に自動カウントされる",
            "通常時ベル合算より条件が明確"
          ],
          "limitations": [
            "マイスロレベル3以上でのみ確認可能",
            "マイスロ表示の1/○○は丸め値のため復元ゲーム数に小さな誤差が生じる"
          ],
          "sourceEvidenceRefs": [
            "SRC_COMMON_7_BELL_1GEKI",
            "SRC_COMMON_7_BELL_NANATETSU"
          ]
        }
      },
      {
        "featureId": "FEAT_REG_ZERO_ART_DISPLAY_ONLY",
        "name": "通常時0pt終了REGからのARTストック当選",
        "adoptionCategory": "DISPLAY_ONLY",
        "calculationRole": "DISPLAY_ONLY",
        "probabilityEngineUsage": false,
        "modelType": "binomial",
        "numeratorInputId": "INP_REG_ZERO_ART_HIT_COUNT",
        "denominatorInputId": "INP_REG_ZERO_COUNT",
        "displayFormat": "percentage",
        "minimumSample": 1,
        "sampleRecommendation": 10,
        "probabilities": {
          "SET_1": 0.019840638721,
          "SET_2": 0.039365099553,
          "SET_3": 0.058577176569,
          "SET_4": 0.077480633369,
          "SET_5": 0.0960792032,
          "SET_6": 0.109830277231
        },
        "description": "通常時に成立したREGを5ゲームすべて0ptで消化した場合の、1個以上ストック当選率。ART中など通常時以外のREG、共通ベル成立、ブレイクチャンス成功、REG開始前からARTストックを保有している可能性がある場合は除外する。ART初当りとの重複を避けるため確率計算には加えない。"
      }
    ]
  },
