  "features": {
    "schemaVersion": "2.0.0",
    "features": [
      {
        "featureId": "FEAT_AT_INITIAL_EXCLUSIVE",
        "name": "AT初当り内訳（弱チェリー直撃／その他）",
        "adoptionCategory": "INCLUDE_PRIMARY",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "multinomial",
        "minimumSample": 1,
        "sampleRecommendation": 8000,
        "numeratorInputId": "INP_WEAK_CHERRY_DIRECT_COUNT",
        "denominatorInputId": "INP_AT_INITIAL_OBSERVED_DENOMINATOR",
        "categoryInputIds": [
          "INP_AT_INITIAL_COUNT"
        ],
        "probabilities": {},
        "categorySubtractInputIds": {
          "INP_AT_INITIAL_COUNT": [
            "INP_WEAK_CHERRY_DIRECT_COUNT"
          ]
        },
        "categoryLabels": [
          "弱チェリー直撃AT",
          "その他AT初当り"
        ],
        "categoryProbabilities": {
          "SET_1": [
            3.0511060259344016e-05,
            0.003741650388250652
          ],
          "SET_2": [
            6.102212051868803e-05,
            0.0037748045001180595
          ],
          "SET_3": [
            9.916094584286804e-05,
            0.0038675189430900955
          ],
          "SET_4": [
            0.00016018306636155608,
            0.004027421623755696
          ],
          "SET_5": [
            0.00022120518688024412,
            0.004111550445702078
          ],
          "SET_6": [
            0.0002898550724637681,
            0.004263878989467016
          ]
        },
        "sourceEvidenceRefs": [
          "SRC_1GEKI_SETTING",
          "SRC_NANA_SPEC",
          "SRC_1GEKI_NORMAL",
          "SRC_NANA_SETTING",
          "SRC_1GEKI_KOYAKU"
        ],
        "selectionRationale": {
          "summary": "マイスロの倖時間突入回数と表示実測確率から試行数を復元し、AT初当りを弱チェリー直撃とその他初当りに排他的分解して使用する。",
          "adoptionReason": "マイスロの通常ゲーム数とAT初当り解析値の分母定義が一致しないため、マイスロ表示の「回数＋1/○○」から試行数を復元する。AT初当り全体と弱チェリー直撃の二重計上も排他的Multinomialで回避する。",
          "shortTermReason": "1日単位では設定間分布の重なりが大きいため単独断定には使用しない。",
          "longTermReason": "通常ゲーム数の蓄積とともにAT初当り全体と直撃構成の双方が情報として加算される。",
          "strengths": [
            "AT初当りと弱チェリー直撃の重複評価を回避",
            "設定1から6まで公開値が揃っている"
          ],
          "limitations": [
            "マイスロ表示の倖時間突入回数と1/○○の両方を入力する必要がある",
            "弱チェリー直撃契機を正しく判別する必要がある",
            "表示分母から復元した試行数は四捨五入して整数化する"
          ],
          "sourceEvidenceRefs": [
            "SRC_1GEKI_SETTING",
            "SRC_NANA_SPEC",
            "SRC_1GEKI_NORMAL",
            "SRC_NANA_SETTING",
            "SRC_1GEKI_KOYAKU"
          ]
        },
        "trialCountInputId": "INP_AT_INITIAL_COUNT",
        "inputTransform": "observed_ratio_to_trials"
      },
      {
        "featureId": "FEAT_WATERMELON",
        "name": "スイカ出現率",
        "adoptionCategory": "INCLUDE_PRIMARY",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "binomial",
        "minimumSample": 1,
        "sampleRecommendation": 8000,
        "displayFormat": "ratio_1_over_n",
        "numeratorInputId": "INP_WATERMELON_COUNT",
        "denominatorInputId": "INP_TOTAL_GAMES",
        "probabilities": {
          "SET_1": 0.011441647597254004,
          "SET_2": 0.011655011655011656,
          "SET_3": 0.01177856301531213,
          "SET_4": 0.012547051442910916,
          "SET_5": 0.013368983957219251,
          "SET_6": 0.014306151645207437
        },
        "sourceEvidenceRefs": [
          "SRC_1GEKI_KOYAKU",
          "SRC_NANA_SPEC"
        ],
        "selectionRationale": {
          "summary": "スイカ出現率を主推測要素として使用する。",
          "adoptionReason": "全状態でカウント可能なスイカを、全ゲーム数を分母として使用する。設定1の1/87.4から設定6の1/69.9まで一貫して高設定ほど出現しやすい。",
          "shortTermReason": "数千Gではブレるが、他Featureと組み合わせる連続的な補助情報になる。",
          "longTermReason": "設定1対6の厳格な識別目安は約1.2万Gで、1日後半から情報量が増えやすい。",
          "strengths": [
            "マイスロで自動カウント可能",
            "他の主要レア役は全設定共通で対象が明確"
          ],
          "limitations": [
            "単独では設定断定不可",
            "隣接設定差は小さい",
            "全ゲーム数と通常時ゲーム数を混同しないこと"
          ],
          "sourceEvidenceRefs": [
            "SRC_1GEKI_KOYAKU",
            "SRC_NANA_SPEC"
          ]
        }
      },
      {
        "featureId": "FEAT_CZ_200G",
        "name": "200G到達時のCZ当選",
        "adoptionCategory": "INCLUDE_SUPPORT",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "binomial",
        "minimumSample": 1,
        "sampleRecommendation": 20,
        "displayFormat": "percentage",
        "numeratorInputId": "INP_CZ_200_HITS",
        "denominatorInputId": "INP_CZ_200_TRIALS",
        "probabilities": {
          "SET_1": 0.1,
          "SET_2": 0.1,
          "SET_3": 0.104,
          "SET_4": 0.15,
          "SET_5": 0.175,
          "SET_6": 0.2
        },
        "sourceEvidenceRefs": [
          "SRC_1GEKI_ZONE",
          "SRC_NANA_ZONE"
        ],
        "selectionRationale": {
          "summary": "200Gゾーン到達時のCZ当選を補助推測要素として使用する。",
          "adoptionReason": "設定1・2の10%に対し設定6は20%で約2倍の差があり、300Gゾーンより相対差が大きい。",
          "shortTermReason": "1日の到達回数は少ないため主判別にはせず、観測できた分だけ補助情報として使う。",
          "longTermReason": "複数回の到達履歴が蓄積した場合に低設定域と高設定域の比較材料になる。",
          "strengths": [
            "設定1対6で2倍の設定差",
            "契機が200G到達と明確"
          ],
          "limitations": [
            "必要試行回数は多い",
            "他契機CZと混同せずゾーン由来を判別する必要がある"
          ],
          "sourceEvidenceRefs": [
            "SRC_1GEKI_ZONE",
            "SRC_NANA_ZONE"
          ]
        }
      }
    ]
  },
