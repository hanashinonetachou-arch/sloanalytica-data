        "featureId": "FEAT_BONUS_FIRST_HIT",
        "name": "ボーナス合算",
        "reason": "ボーナス初当りは通常ゲーム数を分母に直接観測でき、設定1の約1/241から設定6の約1/158まで明確な設定差があるため主軸採用します。",
        "requiredTrials": {
          "value": 7858,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_COMMON_9_BELL",
        "name": "共通9枚ベル",
        "reason": "共通9枚ベルはゲーム数を分母に観測でき、設定1の約1/71から設定6の約1/49まで小役群で最も大きい設定差があるため補助採用します。",
        "requiredTrials": {
          "value": 2998,
          "unit": "ゲーム"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_AT_FIRST_HIT_EXCLUDED",
        "name": "白銀RUSH初当り",
        "reason": "AT初当りはボーナス経由を含む初当り過程と依存し、ボーナス初当りと独立尤度として併用すると当選経路を二重評価するため不採用です。",
        "requiredTrials": {
          "value": 61045,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_COMMON_3_BELL_EXCLUDED",
        "name": "共通3枚ベル",
        "reason": "設定4～6が同一確率で高設定域の識別情報が弱く、同じゲーム分母の共通9枚ベルと併用すると小役情報を重ねるため不採用です。",
        "requiredTrials": {
          "value": 47447,
          "unit": "ゲーム"
        }
      },
      {
        "featureId": "FEAT_SUIKA_EXCLUDED",
        "name": "スイカ",
        "reason": "設定差はありますが共通9枚ベルより情報量が小さく、同一ゲームを分母に複数小役を別binomialで積む重複を避けるため不採用です。",
        "requiredTrials": {
          "value": 28171,
          "unit": "ゲーム"
        }
      },
      {
        "featureId": "FEAT_MODE_TRANSITION_EXCLUDED",
        "name": "有利区間引き継ぎ時のモード移行抽選",
        "reason": "全設定の公開確率が揃っておらず、遷移先の内部モードも実戦中に確定観測できないため設定別尤度を安全に構成できず不採用です。"
      },
      {
        "featureId": "FEAT_OP203_EXPECTATION_EXCLUDED",
        "name": "OPランクごとのOP203当選期待度",
        "reason": "OPランク別の抽選条件と全設定確率を単一Featureとして再現できず、正確なランク別分母も継続観測できないため不採用です。"
      },
      {
        "featureId": "FEAT_GRACE_HIGH_EXCLUDED",
        "name": "恩寵高確移行・転落抽選",
        "reason": "恩寵高確は内部状態で移行・転落を直接確定観測できず、正確な成功回数と分母を取得できないため不採用です。"
      },
      {
        "featureId": "FEAT_RARE_DIRECT_EXCLUDED",
        "name": "レア小役成立時ボーナス直撃抽選",
        "reason": "レア小役別の全設定公開値が揃っておらず、ボーナス初当りの部分経路でもあるため独立尤度として安全に扱えず不採用です。"
      },
      {
        "featureId": "FEAT_GRACE_ZONE_REPLAY_EXCLUDED",
        "name": "リプレイ成立時恩寵ゾーン成功抽選",
