    "selected": [
      {
        "featureId": "FEAT_SPECIAL_DIRECTION",
        "name": "BB中MB入賞時 Specialトロフィー点灯方向",
        "reason": "BB中MB入賞時に必ず下→上/上→下のどちらかを直接観測でき、公開分布は設定1=55/45%、設定2=45/55%、設定5=60/40%、設定6=40/60%と奇偶で方向が反転する。2カテゴリの再現可能な試行分母と具体的な設定別確率が揃うため、偶奇判別の補助Featureとして採用する。"
      },
      {
        "featureId": "FEAT_BB_BGM",
        "name": "BB入賞時 琉球メドレー選択率",
        "reason": "100G以内連チャンという条件を実戦で再現でき、琉球メドレー選択率に公開設定差があるため補助Featureとして採用する。"
      },
      {
        "featureId": "FEAT_RB_BGM",
        "name": "RB入賞時 安里屋ユンタ選択率",
        "reason": "BB後100G以内の連チャン中（途中にRBを挟んでも継続）のRB入賞時に直接観測でき、安里屋ユンタ選択率は設定1/5=6%、設定2=12%、設定6=15%と偶数設定で高い。条件を満たすRBだけを母数にして補助Featureとして採用する。"
      },
      {
        "featureId": "FEAT_SMALL_ROLE_COMPOSITION",
        "name": "通常時小役構成（チェリー・プラム・その他）",
        "reason": "チェリーとプラムはいずれも公開設定差があり、同じ通常1G上の排他的カテゴリとしてMultinomialへ統合すれば非成立情報の二重計上を避けながら両方の情報を利用できる。"
      },
      {
        "featureId": "FEAT_BONUS_OUTCOME",
        "name": "BB・RB出現構成",
        "reason": "BB・RBを別々の独立Binomialにせず、通常1GごとのBB/RB/非当選という排他的な結果として一体評価する。"
      },
      {
        "featureId": "FEAT_BONUS_TRIGGER_COMPOSITION",
        "name": "ボーナス当選契機の構成",
        "reason": "公開された単独/リプレイ/チェリー/プラム×BB/RBの8カテゴリ実質出現率は、各設定で合計がBB/RB総確率と一致する。総ボーナス発生率とは分離し、ボーナス成立後の契機構成として条件付き評価することで追加情報だけを安全に利用する。"
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_BT_REPLAY_BB",
        "name": "BT中 リプレイ+BB in BB実質出現率",
        "reason": "BT中リプレイ+BB in BBには設定差があるが、設定1↔6でも80%識別目安が約111,474 BTゲーム、最も厳しい設定1↔2のJS情報量は約3.38e-8/trial（95%比較目安約28,374,158 trial）と極めて小さい。通常の1日実戦で設定推測結果へ実質的な追加寄与を得にくいため不採用とする。"
      }
    ]
