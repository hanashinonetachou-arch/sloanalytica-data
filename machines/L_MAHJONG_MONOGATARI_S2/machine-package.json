  "selectionSummary": {
    "schemaVersion": "selection-summary-v1",
    "evaluatedCount": 7,
    "selectedCount": 1,
    "rejectedCount": 6,
    "selected": [
      {
        "featureId": "FEAT_AT_FIRST_HIT",
        "name": "AT初当りトータル",
        "reason": "AT初当りトータルは全設定値が公開され、直撃よりはるかに高頻度で実戦情報量が大きい。AT直撃を内包するため直撃とは同時に独立乗算せず、こちらを代表採用する。",
        "requiredTrials": {
          "value": 195035,
          "unit": "有効通常ゲーム"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_BONUS_FIRST_HIT",
        "name": "通常時ボーナス初当り",
        "reason": "ボーナス・AT・合算の初当り事象が相互に重複し、設定差も小さいため、より情報量の大きい解析上AT直撃を代表採用する。",
        "requiredTrials": {
          "value": 1986685,
          "unit": "有効通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_BONUS_OR_AT_FIRST_HIT",
        "name": "通常時ボーナスorAT初当り合算",
        "reason": "ボーナス初当りとAT初当りの双方を内包する合算Featureで、個別Featureとの二重評価になるため採用しない。",
        "requiredTrials": {
          "value": 309225,
          "unit": "有効通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_DIRECT_AT",
        "name": "AT直撃（前兆昇格除外）",
        "reason": "AT直撃はAT初当りトータルに含まれる低頻度な部分事象です。両方を独立に掛けると同じ直撃当選を二重評価するため、より高頻度で実用情報量の大きいAT初当りトータルを代表採用します。",
        "requiredTrials": {
          "value": 42491,
          "unit": "公開直撃抽選対象ゲーム"
        }
      },
      {
        "featureId": "FEAT_DIRECT_AT_PRACTICAL",
        "name": "AT直撃 実戦集計（前兆昇格込み）",
        "reason": "前兆昇格込みの実戦集計で解析上のAT直撃と定義が異なり、同一事象を重複評価するため解析値を代表採用する。",
        "requiredTrials": {
          "value": 67632,
          "unit": "実戦集計通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_KOTEI_APPEARANCE",
        "name": "煌帝出現率",
        "reason": "公開されている煌帝出現率にはAT中の通常選択だけでなく、エンディング後など必ず出現する経路や進行上の強制出現が混在します。設定差も小さく、強制出現を除いた設定別の条件付き確率が公開されていないため、独立した設定推測要素としては採用しません。",
        "requiredTrials": {
          "value": 193671,
          "unit": "公開集計対象ゲーム"
        }
      },
      {
        "featureId": "FEAT_OTHER_PARTIAL",
        "name": "煌帝バトル・CZ撃破閾値・Mashirock等",
        "reason": "全設定の公開値または条件別テーブルが揃っておらず、欠損設定を補間・推定せずResearch未解決のまま推測から除外する。"
      }
    ]
  },
