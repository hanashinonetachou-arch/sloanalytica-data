      {
        "featureId": "FEAT_BONUS_INITIAL_EXCLUDED",
        "name": "通常時ボーナス初当り",
        "reason": "ボーナス初当りは公開のボーナス+AT合算初当りに含まれる部分集合で、別々に使うと同じ通常ゲームの非当選試行と当選事象を重複評価するため不採用です。",
        "requiredTrials": {
          "value": 1986685,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_AT_INITIAL_TOTAL_EXCLUDED",
        "name": "AT初当り（トータル合算）",
        "reason": "AT初当りは合算初当りに含まれるうえAT直撃候補も内包するため、独立尤度として併用すると複数段階で二重評価になるため不採用です。",
        "requiredTrials": {
          "value": 195035,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_KOUTEI_APPEARANCE_EXCLUDED",
        "name": "煌帝出現率",
        "reason": "煌帝出現率は最良でも約1/748と低頻度で、公開1/○○の正確なAT中対戦機会分母を実戦で再現できる契約が未解決のため不採用です。",
        "requiredTrials": {
          "value": 193671,
          "unit": "AT中対戦機会"
        }
      },
      {
        "featureId": "FEAT_AT_DIRECT_BASE_EXCLUDED",
        "name": "AT直撃（前兆中昇格を含まない）",
        "reason": "前兆中昇格を除くAT直撃はAT初当りの部分集合で最良でも約1/4632と低頻度のため、合算初当りとの下流事象の二重評価を避けて不採用です。",
        "requiredTrials": {
          "value": 42491,
          "unit": "通常ゲーム"
        }
      },
