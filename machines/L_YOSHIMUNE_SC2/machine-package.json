      },
      {
        "featureId": "FEAT_COMMON_TAWARA",
        "name": "共通俵",
        "reason": "設定1から6で共通俵確率が約1.8倍変化し、ダイトモで小役確率を観測でき、全状態ゲーム数という公開分母も明確なため主Featureとして採用します。",
        "requiredTrials": {
          "value": 12839,
          "unit": "全ゲーム"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_REACH_PATTERN_EXCLUDED",
        "name": "通常時リーチ目出現",
        "reason": "設定差は大きいものの最良の設定6でも約1/3121と低頻度で、さらに高確率・鷹狩り・連続演出を除外した専用分母を正確に観測する必要があるため、通常実戦の独立Featureとしては不採用です。",
        "requiredTrials": {
          "value": 11879,
          "unit": "高確率・鷹狩り・連続演出中を除く通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_PURE_MISS_PRECURSOR_EXCLUDED",
        "name": "純ハズレ契機 前兆合算",
        "reason": "最良でも約1/4096と低頻度で、純ハズレ契機を通常実戦で確実に識別して初当り経路から分離する必要があるため、誤分類と下流イベント重複を避けて不採用です。",
        "requiredTrials": {
          "value": 30021,
          "unit": "通常ゲーム"
        }
      }
