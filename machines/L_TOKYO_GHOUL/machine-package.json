    "features": [
      {
        "featureId": "FEAT_AT_INITIAL",
        "name": "AT初当り",
        "adoptionCategory": "INCLUDE_PRIMARY",
        "calculationRole": "PROBABILITY",
        "probabilityEngineUsage": true,
        "modelType": "binomial",
        "minimumSample": 1,
        "sampleRecommendation": 8000,
        "weight": 1,
        "displayFormat": "ratio_1_over_n",
        "numeratorInputId": "INP_AT_INITIAL_COUNT",
        "denominatorInputId": "INP_AT_TRIAL_GAMES",
        "probabilities": {
          "SET_1": 0.002535496957403651,
          "SET_2": 0.002628120893561104,
          "SET_3": 0.0028011204481792717,
          "SET_4": 0.0030684258975145753,
          "SET_5": 0.003434065934065934,
          "SET_6": 0.0038270187523918864
        },
        "sourceEvidenceRefs": [
          "SRC_1GEKI_MAIN",
          "SRC_NANA_SPEC",
          "SRC_DMM_SETTING"
        ],
        "selectionRationale": {
          "summary": "AT初当り確率を初回実機テスト版の唯一の確率Featureとして使用する。",
          "adoptionReason": "設定1の1/394.4から設定6の1/261.3まで一貫した設定差があり、複数解析サイトで一致。通常時ゲーム数が分母であることも実戦集計で確認済み。",
          "shortTermReason": "1日単位では単独断定できないが、通常時ゲーム数の蓄積に伴って継続的に情報を得られる。",
          "longTermReason": "設定1対6でも厳格な識別目安は約1.46万G。Hard Evidenceと併用する。",
          "strengths": [
            "入力は通常時ゲーム数とAT初当り回数のみ",
            "複数ソース一致",
            "分母定義を実戦データで検算済み"
          ],
          "limitations": [
            "総ゲーム数ではなく通常時ゲーム数を使う",
            "隣接設定識別には多い試行数が必要"
          ],
          "sourceEvidenceRefs": [
            "SRC_1GEKI_MAIN",
            "SRC_NANA_SPEC",
            "SRC_DMM_SETTING"
          ]
        }
      }
    ],
    "nonAdoptedElements": [
      {
        "name": "100G+α以内CZ当選率",
        "reason": "設定差は大きいが朝一除外・周期開始・100G+α境界の実戦管理が必要で、入力定義ずれのリスクが高いため除外。"
      },
      {
        "name": "CZ合算・CZ内訳",
        "reason": "CZ関連の入力負荷とAT初当りとの相関を考慮し初回版では不採用。"
      },
      {
        "name": "エピソードボーナス／AT直撃／下段リプレイ／弱チェリー契機CZ",
        "reason": "低頻度または状態判別が難しく、1日実戦では効率が低い。"
      },
      {
        "name": "AT終了後の引き戻し",
        "reason": "AT初当りとの依存・包含関係を分離する入力仕様が未確定。"
      }
    ]
  },
