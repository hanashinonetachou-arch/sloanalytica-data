  "ui": {
    "sections": [
      {
        "id": "UI_DESIGN_1",
        "title": "AT初当り",
        "displayOrder": 1,
        "description": "入力方法\n・AT初当りまでに消化したゲーム数を入力します。\n・AT中のゲーム数は除外します。\n・CZ中のゲーム数は含めます。\n\n補足\n・公開解析情報ではAT初当り確率の集計範囲を確認できないため、本アプリでは暫定的にこの定義を採用しています。",
        "items": [
          {
            "type": "input",
            "inputId": "INP_AT_TRIAL_GAMES",
            "label": "AT初当り集計ゲーム数",
            "widget": "number",
            "gridSpan": 12,
            "config": {
              "directInput": true
            }
          },
          {
            "type": "input",
            "inputId": "INP_AT_INITIAL_COUNT",
            "label": "AT初当り",
            "widget": "counter",
            "gridSpan": 6,
            "config": {
              "directInput": true,
              "quickAdd": 1
            }
          }
        ]
      },
      {
        "id": "UI_DESIGN_2",
        "title": "CZ",
        "displayOrder": 2,
        "description": "入力方法\n・レミニセンスと大喰いの利世を、それぞれ出現したときに加算します。\n\n集計上の注意\n・CZ出現率では、CZ消化中8G/回を分母から自動除外します。",
        "items": [
          {
            "type": "input",
            "inputId": "INP_REMINISCENCE_COUNT",
            "label": "レミニセンス",
            "widget": "counter",
            "gridSpan": 6,
            "config": {
              "directInput": true,
              "quickAdd": 1
            }
          },
          {
            "type": "input",
            "inputId": "INP_RIZE_COUNT",
            "label": "大喰いの利世",
            "widget": "counter",
            "gridSpan": 6,
            "config": {
              "directInput": true,
              "quickAdd": 1
            }
          }
        ]
      },
      {
        "id": "UI_DESIGN_3",
        "title": "100G以内のゲーム数解除",
        "displayOrder": 3,
        "description": "入力方法\n・100G到達：朝一モードを除く対象周期を数えます。\n・100G以内CZ以上当選：対象周期で100G以内にCZ以上へ当選した場合に加算します。\n\n除外条件\n・朝一1回目は当選側の集計から除外します。",
        "items": [
          {
            "type": "input",
            "inputId": "INP_100G_TRIAL_COUNT",
            "label": "100G到達",
            "widget": "counter",
            "gridSpan": 6,
            "config": {
              "directInput": true,
              "quickAdd": 1
            }
          },
          {
            "type": "input",
            "inputId": "INP_100G_HIT_COUNT",
            "label": "100G以内CZ以上当選",
            "widget": "counter",
            "gridSpan": 6,
            "config": {
              "directInput": true,
              "quickAdd": 1
            }
          }
        ]
      },
      {
        "id": "UI_DESIGN_4",
        "title": "AT引き戻し",
        "displayOrder": 4,
        "description": "入力方法\n・AT終了：ATが終了するたびに加算します。\n・AT引き戻し当選：AT終了後に引き戻した場合に加算します。",
        "items": [
          {
            "type": "input",
            "inputId": "INP_AT_END_COUNT",
            "label": "AT終了",
            "widget": "counter",
            "gridSpan": 6,
            "config": {
              "directInput": true,
              "quickAdd": 1
            }
          },
          {
            "type": "input",
            "inputId": "INP_AT_RETURN_COUNT",
            "label": "AT引き戻し当選",
            "widget": "counter",
            "gridSpan": 6,
            "config": {
              "directInput": true,
              "quickAdd": 1
            }
          }
        ]
      },
      {
        "id": "UI_DESIGN_5",
        "title": "設定確定・否定情報",
        "displayOrder": 5,
        "items": [
          {
            "type": "input",
            "inputId": "INP_EVI_ENDING_CARD",
            "label": "エンディングカード",
            "widget": "select",
            "gridSpan": 12
          },
          {
            "type": "input",
            "inputId": "INP_EVI_AT_END_SCREEN",
            "label": "AT終了画面",
            "widget": "select",
            "gridSpan": 12
          },
          {
            "type": "input",
            "inputId": "INP_EVI_CZ_END_SCREEN",
