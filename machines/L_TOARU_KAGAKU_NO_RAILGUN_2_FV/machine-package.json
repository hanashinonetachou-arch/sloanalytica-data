  "selectionSummary": {
    "schemaVersion": "selection-summary-v1",
    "evaluatedCount": 12,
    "selectedCount": 6,
    "rejectedCount": 1,
    "selected": [
      {
        "featureId": "FEAT_AT_INITIAL",
        "name": "AT初当り",
        "reason": "通常ゲーム数を分母として6設定すべての公開確率があり直接観測できるため採用。"
      },
      {
        "featureId": "FEAT_CZ_TOTAL",
        "name": "CZ合算",
        "reason": "種類別CZをまとめた親表現で分母が明確かつ計数負担が低いため採用。"
      },
      {
        "featureId": "FEAT_AT_START_STAGE",
        "name": "AT開始時のステージ振り分け",
        "reason": "開始時3ステージの完全な設定別選択率が公開され、直接観測できるため採用。"
      },
      {
        "featureId": "FEAT_CZ_TYPE_CONDITIONAL",
        "name": "CZの種類振り分け",
        "reason": "既存CZ合算を総数、追加Featureを条件付き種類内訳として因数分解でき、二重計上を避けて高設定ほど増える上位CZ比率を利用できるため採用。"
      },
      {
        "featureId": "FEAT_EPISODE_BONUS_DIRECT",
        "name": "エピソードBONUS直撃確率",
        "reason": "通常Gを分母に完全な6設定実質確率が公開され、低頻度ながら設定差が大きいため補助Featureとして採用。"
      },
      {
        "featureId": "FEAT_PAYOUT_CARD_NON_HARD",
        "name": "設定示唆カードの出現率（非EVIDENCE）",
        "reason": "出現率が公開されており、設定を直接限定するカードをEvidence側へ分離した条件付き分布として評価できるため採用。"
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_REF_CZ_TYPES",
        "name": "種類別CZ",
        "reason": "CZ合算と同時利用すると同じCZ事象を重複評価するためv1では参考扱い。"
      }
    ]
  },
