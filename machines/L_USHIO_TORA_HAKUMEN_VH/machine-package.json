  "selectionSummary": {
    "schemaVersion": "selection-summary-v1",
    "evaluatedCount": 4,
    "selectedCount": 2,
    "rejectedCount": 2,
    "selected": [
      {
        "featureId": "FEAT_CZ_INITIAL",
        "name": "CZ初当り",
        "reason": "通常ゲームを分母にした全設定の公開確率が揃い、AT初当りより発生頻度が高く設定1対6の1G当たり識別情報も大きいため主Featureとして採用します。",
        "requiredTrials": {
          "value": 96183,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_RESET_USHITORA_MODE_DIST",
        "name": "設定変更時うしとらモード規定CZ回数振り分け",
        "reason": "設定変更1回を試行単位とする完全な規定CZ回数分布で通常時CZ初当りとは別の条件付き情報を持つため、判別完了セッションだけを対象に補助Featureとして採用します。",
        "requiredTrials": {
          "value": 34,
          "unit": "設定変更1回"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_AT_INITIAL_EXCLUDED",
        "name": "AT初当り",
        "reason": "AT初当りはCZを経由する同一遊技経路を含み、CZ初当りと独立二項尤度で併用すると下流結果を重複評価するため不採用です。",
        "requiredTrials": {
          "value": 229368,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_RESET_AT_CEILING_DIST_EXCLUDED",
        "name": "設定変更時AT間天井G数振り分け",
        "reason": "公開値は設定変更時に内部選択されるAT間天井の分布ですが、2000G未満でAT当選した通常実戦では選択天井を観測できず打ち切りが大量に生じるため、公開multinomialと同じ試行を再現できず不採用です。",
