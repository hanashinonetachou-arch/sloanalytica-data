        "defaultExpanded": true,
        "items": [
          {
            "type": "input",
            "inputId": "INP_NORMAL_GAMES",
            "label": "通常ゲーム",
            "widget": "number",
            "gridSpan": 12,
            "config": {
              "directInput": true,
              "quickAdd": [
                50
              ],
              "emptyMeansUnobserved": true,
              "observedZeroAllowed": true
            }
          },
