    "rejected": [
      {
        "featureId": "FEAT_AT_INITIAL",
        "name": "AT初当り",
        "reason": "AT初当りには設定差がありますが、合算初当りの部分集合で同じ当選情報を二重に数えることになります。さらにAT単体は試行数も少ないため、自分区間では高頻度な合算初当りを優先して不採用です。",
        "requiredTrials": {
          "value": 24324,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_AT_PREDECESSOR",
        "name": "着席前AT初当り",
        "reason": "着席時入力欄は記録用として残しますが、機種固有の実機確認完了まで前任者Featureは推測不参加とします。",
        "requiredTrials": {
          "value": 24324,
          "unit": "データカウンターゲーム"
        }
      },
      {
        "featureId": "REJECTED_STATE_TRANSITION",
        "name": "成立役別の内部状態移行抽選",
        "reason": "弱チェリー・スイカなどからの状態移行に設定差がありますが、通常・高確・超高確を完全に観測できません。状態誤認を含む母数は設定差より大きな偏りを作り得るため不採用です。"
      },
      {
        "featureId": "REJECTED_STATE_INITIAL_HIT",
        "name": "内部状態別の成立役初当り抽選",
        "reason": "高確中の強レア役などに大きな設定差がありますが、前提となる内部状態を確実に分類できません。条件付き確率の分母を正しく作れないため、合算初当りへ集約しています。"
      },
      {
        "featureId": "REJECTED_TSUKIMIZAKE_DIRECT",
        "name": "月見酒ボーナス経由の前兆ステージからのAT直撃",
        "reason": "設定差があるとされていますが、月見酒ボーナス経由という限定条件で試行機会が少なく、1日の実戦で安定した母数を作りにくいため数値Featureにはしていません。"
      }
    ]
  },
