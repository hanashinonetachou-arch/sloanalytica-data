        "minimumSample": 1000,
        "sampleRecommendation": 6000,
        "probabilities": {},
        "selectionRationale": {
          "summary": "ボーナス無抽選区間の影響を含む実遊技上の赤BIG・青BIG・REG出現率を、非ボーナスを残余とする多項分布で評価する。",
          "adoptionReason": "青BIGとREGには設定差があり、合算を別Featureにせず種別構成と回数を一度に評価できる。",
          "shortTermReason": "短時間ではボーナスの偏りが大きいため暫定評価とする。",
          "longTermReason": "ゲーム数が増えるほど青BIG・REGの出現率差が比較材料になる。",
          "strengths": [
            "入力しやすい主軸データ",
            "合算との二重評価がない"
          ],
          "limitations": [
            "ボーナス消化ゲームは母数から除外する",
            "内部成立中やREG後無抽選区間は母数に含める"
          ],
          "sourceEvidenceRefs": [
            "SRC_RATE_NANATETSU",
            "SRC_RATE_PWORLD"
          ]
        }
      },
