    "rejected": [
      {
        "featureId": "FEAT_ONE_YAKU_B",
        "name": "1枚役B",
        "reason": "1枚役Bには設定差がありますが、停止形と打ち方を毎ゲーム正確に判別する必要があり、実戦での入力ミス・取りこぼしが尤度を直接歪めるリスクがあります。スイカやART中共通ベルなど、より安定して観測できる要素を優先するため不採用です。",
        "requiredTrials": {
          "value": 59580,
          "unit": "小役集計ゲーム"
        }
      },
      {
        "featureId": "REJECTED_KAKUTEI_ROLE",
        "name": "確定役確率",
        "reason": "設定1の約1/5041から設定6の約1/3277まで差がありますが、1日7000Gでも期待出現回数は約1〜2回です。大半の実戦でサンプル不足となるため推測計算には使用しません。"
      },
      {
        "featureId": "REJECTED_WATERMELON_BONUS",
        "name": "スイカ＋ボーナス同時当選率",
        "reason": "設定差はありますが5.2%前後でほぼ横ばいで、設定1と6の差は非常に小さいです。スイカ成立回数そのものを使う方が情報効率が高いため不採用です。"
      },
      {
        "featureId": "REJECTED_ONE_YAKU_B_BONUS",
        "name": "1枚役B＋ボーナス同時当選率",
        "reason": "同時当選率にも設定差はありますが8.2〜8.7%程度と差が小さく、さらに1枚役Bの正確な停止形判別が必要です。観測負荷に対して追加情報量が小さいため不採用です。"
      },
      {
        "featureId": "REJECTED_REG_BAR",
        "name": "REG中BAR揃い・カットイン期待度",
        "reason": "高設定ほど優遇されていますが、BAR揃いは約1/136〜1/128、カットイン期待度の差も数ポイント以内です。1日に得られるREG消化ゲームでは設定間のばらつきを十分分離しにくいため不採用です。"
      }
    ]
