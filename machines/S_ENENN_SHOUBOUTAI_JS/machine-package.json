        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_BONUS_INITIAL_EXCLUDED",
        "name": "ボーナス初当り",
        "reason": "ボーナス初当りにも設定差はありますが、炎炎激闘へ至る通常時の初当り経路と強く依存し、両方を独立Featureとして足すと同じ好挙動を重複評価しやすいため不採用です。",
        "requiredTrials": {
          "value": 67797,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_CROSS_CHANGE_EXCLUDED",
        "name": "十字目変換時ボーナス当選率",
        "reason": "十字目変換時のボーナス当選率には設定差がありますが、ボーナス初当りの部分集合で、炎炎激闘へつながる同一生成過程を追加評価することになるため現行モデルでは不採用です。",
        "requiredTrials": {
          "value": 333,
          "unit": "十字目変換成立"
        }
      },
      {
        "featureId": "FEAT_CROSS_REPLAY_EXCLUDED",
        "name": "十字リプレイ時ボーナス当選率",
        "reason": "十字リプレイ時のボーナス当選率は設定差が大きいもののボーナス初当りの部分集合です。主軸の炎炎激闘初当りと合わせたときの依存を安全に分離できないため不採用です。",
        "requiredTrials": {
          "value": 79,
          "unit": "十字リプレイ成立"
        }
      },
      {
        "featureId": "FEAT_SHADOW_EPB_EXCLUDED",
        "name": "初当り+伝導者の影ステージ EPB期待度",
        "reason": "初当りボーナス+伝導者の影でのEPB期待度には設定差がありますが、初当りボーナス中と伝導者の影中の抽選を合算した値で、実戦中に同じ公開条件の分母を安定して再現しにくいため不採用です。",
        "requiredTrials": {
          "value": 181,
          "unit": "初当りボーナス+伝導者の影の評価機会"
        }
      },
      {
        "featureId": "FEAT_SHINRA_SUCCESS_EXCLUDED",
        "name": "森羅万象成功期待度",
        "reason": "森羅万象成功率には設定差がありますが27%～31%と差が小さく、森羅万象への到達自体も限定されるため必要試行量が大きく、実戦的な情報量が低いため不採用です。",
        "requiredTrials": {
          "value": 943,
          "unit": "森羅万象突入"
        }
      },
      {
        "featureId": "REJ_ENEN_REG_HINT",
        "name": "REGキャラ紹介の設定2・5示唆／設定1・4・6示唆",
        "reason": "特定設定の示唆傾向はありますが設定別出現率が公開されていないため数値尤度には変換できません。否定・下限・確定パターンだけEvidenceとして採用します。"
      },
      {
        "featureId": "REJ_ENEN_END_HINT",
        "name": "ボーナス終了画面の高設定示唆（弱/強）",
