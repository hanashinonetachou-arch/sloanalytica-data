    "selected": [
      {
        "featureId": "FEAT_AT_INITIAL",
        "name": "AT初当り",
        "reason": "全設定値と観測母数が揃い、通常ゲーム単位で主要な設定差を直接評価できるため主Featureとして採用する。",
        "requiredTrials": {
          "value": 28863,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_BONUS_INITIAL",
        "name": "ボーナス初当り",
        "reason": "公開値は利用可能だが主要Featureとの経路重複または同一事象の包含があるため、二重評価を避け主Featureが使えない場合のFallbackとしてのみ採用する。",
        "requiredTrials": {
          "value": 47680,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_AT_RETURN_RED_UI",
        "name": "AT終了後の引き戻し（赤UI中）",
        "reason": "AT終了後という通常時初当りとは別の条件付き段階で、赤UI中の引き戻し判定機会を母数にできるため補助Featureとして採用する。コンティニューゾーン内の即復帰は含めない。",
        "requiredTrials": {
          "value": 174,
          "unit": "AT終了後の引き戻し判定機会"
        }
      },
      {
        "featureId": "FEAT_CZ_INITIAL",
        "name": "CZ合算（ロックオン＋一八チャレンジ）",
        "reason": "CZ合算は設定別数値と観測値が取得できるがAT/ボーナスの上流経路で因果重複するため、AT初当り・ボーナス初当りが利用できない場合だけ使うFallbackとして採用する。",
        "requiredTrials": {
          "value": 594127,
          "unit": "通常ゲーム"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_AT_DIRECT",
        "name": "通常時AT直撃",
        "reason": "AT直撃には大きな設定差があるが、現在採用しているAT初当りの内数。同じ通常ゲーム母数でAT初当りと直撃を独立binomialとして同時評価すると直撃ATを二重計上するため、現行の因数分解契約では不採用。",
        "requiredTrials": {
          "value": 29870,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_BONUS_DIRECT_WEAK_GROUP",
        "name": "弱チェリー・スイカ・チャンス目からのボーナス直撃",
        "reason": "小役別の直撃当選率には設定差があるが、ボーナス初当りの内数であり、既存ボーナス初当りと独立尤度として同時利用すると同じボーナスを二重評価するため現時点では不採用。",
        "requiredTrials": {
          "value": 454,
          "unit": "対象弱レア役成立"
        }
      },
      {
        "featureId": "FEAT_BONUS_DIRECT_STRONG_CHERRY",
        "name": "強チェリーからのボーナス直撃",
        "reason": "強チェリーからのボーナス直撃には設定差があるが、ボーナス初当りの内数であり、既存ボーナス初当りと独立尤度として同時利用すると同じボーナスを二重評価するため現時点では不採用。",
        "requiredTrials": {
          "value": 311,
          "unit": "強チェリー成立"
        }
      },
      {
        "featureId": "FEAT_BONUS_DIRECT_TOTAL",
        "name": "ボーナス直撃合算",
        "reason": "ボーナス直撃合算は小役別直撃の派生合算で、さらにボーナス初当りにも内包される。同時採用すると同一当選を重複評価するため不採用。",
        "requiredTrials": {
          "value": 16649,
          "unit": "通常ゲーム"
        }
      }
    ]
