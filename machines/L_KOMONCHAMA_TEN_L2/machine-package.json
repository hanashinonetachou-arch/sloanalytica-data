    "selected": [
      {
        "featureId": "FEAT_LANTERN_LIGHT",
        "name": "世直し提灯 実質点灯確率（前兆込み）",
        "reason": "通常時の世直し提灯点灯率そのものに設定差があり、通常ゲーム数を分母として直接数えられるため採用します。AT初当りより上流の抽選を観測できる主Featureです。",
        "requiredTrials": {
          "value": 387153,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_LANTERN_AT",
        "name": "世直し提灯点灯時のAT期待度",
        "reason": "世直し提灯が点灯した後のAT当選率にも設定差があるため、点灯回数を条件分母として採用します。点灯率と点灯後AT当選率を分けることで、どの段階で差が出たかを重複なく評価できます。",
        "requiredTrials": {
          "value": 54,
          "unit": "世直し提灯点灯"
        }
      },
      {
        "featureId": "FEAT_AT_FIRST_HIT",
        "name": "AT初当り確率",
        "reason": "AT初当りにも設定差はありますが、世直し提灯の詳細データと経路が重なるため、提灯を記録していない場合だけ使うFallbackとします。詳細データが有効ならAT初当りは自動的に抑制して二重評価しません。",
        "requiredTrials": {
          "value": 16136,
          "unit": "通常ゲーム"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_50G_SAKURA",
        "name": "50G到達時の千年桜移行率",
        "reason": "世直し提灯・AT初当りと同じ初当り経路の上流情報で、同時採用すると重複評価になるため不採用。",
        "requiredTrials": {
          "value": 580,
          "unit": "50G到達"
        }
      },
      {
        "featureId": "FEAT_MYSTERY_AT",
        "name": "AT謎当り出現率",
        "reason": "AT初当りの一部と重複し、設定6でも約1/6715と低頻度で実戦中に十分な回数を観測しにくいため不採用。",
        "requiredTrials": {
          "value": 31105,
          "unit": "通常ゲーム"
        }
      }
    ]
