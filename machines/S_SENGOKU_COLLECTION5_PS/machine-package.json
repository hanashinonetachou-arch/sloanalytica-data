    "selected": [
      {
        "featureId": "FEAT_AT_INITIAL",
        "name": "AT「異世界制覇ラッシュ」初当り",
        "reason": "AT初当りは設定1約1/350.1から設定6約1/233.2まで全設定の確率が公開され、通常ゲーム数を分母として直接観測できるため主軸に採用します。",
        "requiredTrials": {
          "value": 12598,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_VACATION_10PT",
        "name": "バカンスポイント10pt時 鬼ヶ島バカンス当選",
        "reason": "バカンスポイント10pt到達時の鬼ヶ島バカンス当選率は全設定で公開され、10pt到達とルーレット結果を直接観測できるため条件付きの補助Featureとして採用します。",
        "requiredTrials": {
          "value": 166,
          "unit": "バカンスポイント10pt到達"
        }
      },
      {
        "featureId": "FEAT_7_ILLUSTRATION",
        "name": "AT中7揃い後1枚絵",
        "reason": "AT中7揃い後の1枚絵は全設定の排他的な振り分けが公開され、1回の7揃いごとに表示カテゴリを直接観測できるためMultinomialの補助Featureとして採用します。",
        "requiredTrials": {
          "value": 36,
          "unit": "AT中7揃い"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_VACATION_RATE_EXCLUDED",
        "name": "鬼ヶ島バカンス実質突入率",
        "reason": "鬼ヶ島バカンス実質突入率にも設定差がありますが、10pt時抽選など複数の当選経路を合算した結果であり、採用する10pt条件付き抽選やAT初当りと同じ通常時の好挙動を重複評価しやすいため不採用です。",
        "requiredTrials": {
          "value": 50843,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_7_FLASH_EXCLUDED",
        "name": "AT中7揃い時バックランプフラッシュ",
        "reason": "7揃い時バックランプにも設定差がありますが、採用する1枚絵と同じ7揃い1回から同時に発生する情報です。両者の条件付き独立性が公開されておらず、独立Featureとして乗算すると同一試行の情報量を過大評価するため不採用です。",
        "requiredTrials": {
          "value": 36,
          "unit": "AT中7揃い"
        }
      },
      {
        "featureId": "evidence_and_reference",
        "name": "AT終了画面の確定系以外のパターン",
        "reason": "コスプレ2人・白ドレス・しずもん絵はEvidenceとして採用しますが、それ以外の終了画面は設定別の完全な出現確率や確定条件が公開されていないため数値Featureには採用しません。"
      },
      {
        "featureId": "reference",
        "name": "弱チェリー/スイカ契機・モードC/ゾーン・極楽後モード移行・終了時コマンド",
        "reason": "設定判別要素として確認していますが、内部モードの確定観測が必要、または全設定の完全な確率表が公開されていない要素です。正しい分母・分子や尤度を構築できないため推測計算には採用しません。"
      }
    ]
