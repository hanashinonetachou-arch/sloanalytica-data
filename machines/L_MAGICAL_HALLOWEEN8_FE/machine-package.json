    "selected": [
      {
        "featureId": "FEAT_ART_INITIAL",
        "name": "ART初当り",
        "reason": "ART初当りの設定差が大きいため主軸採用。",
        "requiredTrials": {
          "value": 10611,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_COMMON_COIN",
        "name": "共通コイン",
        "reason": "共通コインは高頻度で設定差があり、実機連動機能またはART中ナビなしベルで観測できるため採用。",
        "requiredTrials": {
          "value": 1726,
          "unit": "小役集計ゲーム"
        }
      },
      {
        "featureId": "FEAT_DOKOMAJI",
        "name": "どこまじ当選率",
        "reason": "どこまじは設定1の1.6%から設定6の23.4%まで大差がある。超高確・ART中・朝一30G程度を除外して補助採用する。ただし内部当選しても演出が必ず出るわけではないため重み0.5とする。",
        "requiredTrials": {
          "value": 13,
          "unit": "通常時ボーナス"
        }
      },
      {
        "featureId": "FEAT_REG_REQUIRED_KILLS",
        "name": "殲滅ボーナス 規定撃破数",
        "reason": "殲滅ボーナスの規定撃破数は25・50体を中心に設定差が非常に大きく、少数回でも情報量が高い。一撃フラグやレア役多数などで規定数を一意に特定できない回だけ除外して補助採用する。",
        "requiredTrials": {
          "value": 2,
          "unit": "判別できた殲滅ボーナス"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_ART_PREDECESSOR",
        "name": "着席前ART初当り",
        "reason": "着席時データカウンターのART初当り回数・累計ゲーム数が、公開ART初当り確率と同じ試行母集団を表すことを実機で確認できていないため、現版では推測に使用しない。実機確認後に再評価する。",
        "requiredTrials": {
          "value": 10611,
          "unit": "データカウンターゲーム"
        }
      },
      {
        "featureId": "REJECTED_BONUS_RATE",
        "name": "ボーナス確率・特定ボーナス確率",
        "reason": "設定差はありますが、ART初当りやどこまじと同じボーナス経路の情報を多く共有します。契機別まで細分化すると1日の各カテゴリ試行も少なくなるため、現構成では独立尤度として重ねず不採用です。"
      },
      {
        "featureId": "REJECTED_REPLAY_BONUS",
        "name": "リプレイ＋ボーナス同時当選期待度",
        "reason": "設定差は0.7%〜1.0%と小さく、同時当選を十分な精度で分離するには非常に多くのリプレイ観測が必要です。入力負荷に対する追加情報量が小さいため不採用です。"
      },
      {
        "featureId": "REJECTED_COIN_BASE",
        "name": "50枚あたりのゲーム数",
        "reason": "高設定ほど高ベースですが、主因は採用済みの共通コイン確率です。同じコイン持ち情報を二重計上するため独立Featureにはしません。"
      },
      {
        "featureId": "REJECTED_MAJICHAN_RATE",
        "name": "まじかるちゃんす発生率（状態・契機別）",
        "reason": "大きな設定差を持つ条件がありますが、低確/通常/高確など内部状態とボーナス契機を正確に分類する必要があります。状態誤認を含む母数は尤度を大きく歪めるため、現時点では観測条件を絞れる『どこまじ』を優先しています。"
      },
      {
        "featureId": "REJECTED_NORMAL_MODE",
        "name": "詠唱チャレンジ終了時の通常モード抽選",
        "reason": "ART当選有無など条件別に設定差がありますが、選択された内部モードそのものを直接観測できません。結果からモードを推定して再び設定推測へ使う循環を避けるため不採用です。"
      },
      {
        "featureId": "REJECTED_ENCOUNTER_ZONE",
        "name": "エンカウントゾーン出現率",
        "reason": "設定差はありますが発生機会が限定され、1日で十分な独立試行を得にくい要素です。ART初当り・共通コイン・規定撃破数など、より直接かつ高情報量の要素を優先します。"
      }
    ]
  },
