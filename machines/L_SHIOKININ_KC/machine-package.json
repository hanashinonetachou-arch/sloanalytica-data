    "selected": [
      {
        "featureId": "FEAT_AT_INITIAL",
        "name": "AT初当り",
        "reason": "AT初当りは1/456.0～1/319.9と段階的な設定差があり、通常ゲーム数を分母に直接観測できるため主軸に採用します。",
        "requiredTrials": {
          "value": 22163,
          "unit": "通常ゲーム"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_BONUS_INITIAL_EXCLUDED",
        "name": "ボーナス初当り",
        "reason": "ボーナス初当りにも1/230.7～1/169.0の設定差がありますが、ボーナスを経由してATへ至る通常時の当選経路と強く依存し、AT初当りと同時採用すると好挙動を重複評価しやすいため不採用です。",
        "requiredTrials": {
          "value": 14838,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "REJ_SHIOKI_RESET_CEILING",
        "name": "設定変更時の天井短縮率",
        "reason": "設定変更時に408G天井が選ばれる設定差候補ですが、公開されている具体値は設定1の40.8%のみで全設定の比較表がありません。さらに設定変更を確定できる台だけが母集団になるため数値推測には不採用です。"
      },
      {
        "featureId": "REJ_SHIOKI_RARE_BONUS",
        "name": "非前兆中レア役からのボーナス当選率",
        "reason": "弱チェリー・チャンス目・強チェリーからのボーナス抽選は公開されていますが具体値は設定1のみで、設定別確率が揃っていないため不採用です。"
      },
      {
        "featureId": "REJ_SHIOKI_RARE_CZ",
        "name": "非前兆中スイカからの頼み人チャンス当選率",
        "reason": "スイカからCZを抽選することは公開されていますが設定別の当選率は未公表で、現状は設定1の数値しか比較できないため不採用です。"
      },
      {
        "featureId": "REJ_SHIOKI_PAYOUT_456",
        "name": "456OVERの設定5・6期待度アップ",
        "reason": "456OVERは設定4以上を確定できるためEvidenceとしては採用しますが、設定5・6が出やすいという追加傾向は設定別出現率がなく数値尤度には使いません。"
      },
      {
        "featureId": "REJ_SHIOKI_DOOR_HINT",
        "name": "極限バトル1G目 3人集合背景",
        "reason": "3人集合背景は高設定期待度アップですが設定別出現率が公開されていないため数値推測には使いません。金背景の設定4以上だけEvidenceとして採用します。"
      },
      {
        "featureId": "REJ_SHIOKI_END_HINT",
        "name": "終了画面の奇数・偶数・高設定示唆",
        "reason": "死神・虎などの設定示唆は設定別出現率が公開されていないため数値尤度を作れません。設定2以上・4以上・6を確定できる画面のみEvidenceとして採用します。"
      }
    ]
  },
