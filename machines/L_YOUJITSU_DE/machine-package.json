    "selected": [
      {
        "featureId": "FEAT_CZ_INITIAL",
        "name": "CZ初当り",
        "reason": "通常ゲームを分母にしたCZ初当りは全設定値が揃い、AT初当りより発生頻度と設定1対6の1G当たり識別情報が大きいため主Featureとして採用します。",
        "requiredTrials": {
          "value": 14988,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "FEAT_RED_PUSH_ON_SUCCESS",
        "name": "連続演出成功時の赤PUSH",
        "reason": "連続演出成功後の赤PUSH出現という条件付き確率で、成功回数を分母に分離して観測できるため補助Featureとして採用します。",
        "requiredTrials": {
          "value": 1262,
          "unit": "通常時の連続演出成功"
        }
      },
      {
        "featureId": "FEAT_CZ_SUCCESS_DAXEL_FLASH",
        "name": "CZ成功時ダクセルフラッシュ",
        "reason": "CZ成功を条件としたダクセルフラッシュ出現率で、CZ成功回数という専用分母により総CZ初当りとは別の条件付き情報として評価できるため採用します。",
        "requiredTrials": {
          "value": 237,
          "unit": "CZ成功"
        }
      },
      {
        "featureId": "FEAT_PERIODIC_CZ_TYPE",
        "name": "通常周期CZ種別振り分け",
        "reason": "特定周期でCZ当選した後のCZ種別という条件付き完全分布で、対象CZ回数を専用分母として総CZ初当りとは分離できるため補助Featureとして採用します。",
        "requiredTrials": {
          "value": 175,
          "unit": "AT後1・4周期目以外の周期抽選によるCZ当選"
        }
      },
      {
        "featureId": "FEAT_BONUS_END_SCREEN",
        "name": "よう実BONUS終了画面 櫛田桔梗",
        "reason": "よう実BONUS終了を分母に櫛田桔梗の出現を直接観測でき、通常時CZ率とは異なる条件付き演出確率なので補助Featureとして採用します。",
        "requiredTrials": {
          "value": 1027,
          "unit": "よう実BONUS終了1回"
        }
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_AT_INITIAL_EXCLUDED",
        "name": "AT初当り",
        "reason": "AT初当りはCZ成功など下流経路を含み、CZ初当りと同じ通常ゲームから独立二項尤度で評価すると遊技経路を重複評価するため不採用です。",
        "requiredTrials": {
