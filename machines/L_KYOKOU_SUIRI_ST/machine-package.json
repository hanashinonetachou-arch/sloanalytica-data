  "selectionSummary": {
    "schemaVersion": "selection-summary-v1",
    "evaluatedCount": 12,
    "selectedCount": 7,
    "rejectedCount": 5,
    "selected": [
      {
        "featureId": "FEAT_CZ_INITIAL",
        "name": "CZ初当り",
        "reason": "全設定の公開確率と通常ゲーム分母が揃うため主Featureとして採用。"
      },
      {
        "featureId": "FEAT_BONUS_INITIAL",
        "name": "ボーナス初当り",
        "reason": "CZ初当りとの包含重複を避けるためFallbackとして採用。"
      },
      {
        "featureId": "FEAT_CZ_ONE_SHOT_SUCCESS",
        "name": "CZ一発成功抽選",
        "reason": "CZ開始時の条件付き抽選に設定差があり、初当りとは別情報のため採用。"
      },
      {
        "featureId": "FEAT_COMMON_BELL_DIRECT",
        "name": "共通ベル時・CZ/ボーナス直撃抽選",
        "reason": "共通ベル成立後の結果を一つのmultinomialとして扱い、CZ/ボーナス直撃の設定差を二重計上せず利用できるため採用。"
      },
      {
        "featureId": "FEAT_INITIAL_EPISODE",
        "name": "初回エピソード振り分け",
        "reason": "設定変更時と虚構連駆け抜け後を除外すれば大きな設定差を再現可能。EP4/EP5はHard Evidenceへ分離して採用。"
      },
      {
        "featureId": "FEAT_EPISODE_START_CLEAR",
        "name": "各エピソード開始時・エピソードクリア当選率",
        "reason": "有効なエピソード開始のみ数えれば設定1 36.6%から設定6 46.4%の差を利用できるため採用。"
      },
      {
        "featureId": "FEAT_BONUS_END_SCREEN",
        "name": "虚構推理ボーナス終了画面出現率",
        "reason": "通常画面にも奇偶・高低の設定差があるため採用。確定系はHard Evidenceへ分離。"
      }
    ],
    "rejected": [
      {
        "featureId": "FEAT_BONUS_DIRECT",
        "name": "ボーナス直撃",
        "reason": "設定差は大きいが、採用した共通ベル時ボーナス直撃抽選の実質確率と同じ情報を含み、独立評価すると二重計上になるため不採用。"
      },
      {
        "featureId": "FEAT_HIGH_TRANSITION_WEAK_RARE",
        "name": "スイカ・弱チェリー成立時の高確移行振り分け",
        "reason": "公開数値はあるが内部高確の開始・終了を毎回確定観測できず、正確な結果分類が困難なため不採用。"
      },
      {
