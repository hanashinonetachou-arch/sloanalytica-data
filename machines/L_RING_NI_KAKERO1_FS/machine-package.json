        "requiredTrials": {
          "value": 5482,
          "unit": "データカウンターゲーム"
        }
      },
      {
        "featureId": "FEAT_KIKU_NONRARE_SUCCESS",
        "name": "菊チャンス中 非レア役成功",
        "reason": "設定1対6で4倍の差はありますが、絶対確率が0.39%～1.56%と低く、1日の実戦では有効試行が不足します。概算で数百回規模の対象試行が必要になるため推測計算には不採用とし、複数回確認した場合の参考材料に留めます。",
        "requiredTrials": {
          "value": 466,
          "unit": "非レア役成立の菊チャンス"
        }
