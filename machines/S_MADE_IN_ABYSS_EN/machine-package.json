      {
        "featureId": "FEAT_CZ_INITIAL_EXCLUDED",
        "name": "CZ初当り",
        "reason": "CZ初当りにも設定差がありますがCZはATへの主要経路であり、AT初当りと同時に評価すると同じ通常時の好挙動を二重評価しやすいため不採用です。",
        "requiredTrials": {
          "value": 17594,
          "unit": "通常ゲーム"
        }
      },
      {
        "featureId": "REJ_ABYSS_FREEZE",
        "name": "始まっていたのですフリーズ",
        "reason": "設定1の1/32768から設定6の1/4369まで大きな設定差がありますが、AT当選へ直結する非常に低頻度な事象でAT初当りと同時採用すると一部を二重評価します。通常実戦での試行数も少ないため不採用です。"
      },
      {
        "featureId": "REJ_ABYSS_NARAKU",
        "name": "奈落の探窟域突入率",
        "reason": "設定差はありますが1/430.2～1/405.0程度で差が小さく、設定4が最大で単調でもありません。必要試行量が大きく判別情報量が低いため不採用です。"
      },
      {
        "featureId": "REJ_ABYSS_WHISTLE",
        "name": "白笛の導き中の笛獲得振り分け",
        "reason": "赤・蒼・月・黒・白の振り分けに設定差はありますが差が非常に小さく、白笛でも4.60%～3.57%程度です。多数の白笛の導き試行が必要になり実戦的情報量が低いため不採用です。"
      },
      {
        "featureId": "REJ_ABYSS_STABLE_CHALLENGE",
        "name": "安定/勝負選択時の勝率",
        "reason": "設定差は大きいもののプレイヤーが選んだ『安定/勝負』で母集団が分かれ、結果はAT初当りにも含まれます。選択行動による偏りとAT初当りとの重複評価を避けるため不採用です。"
      },
      {
        "featureId": "REJ_ABYSS_AT_PAYOUT",
        "name": "AT突入時の平均獲得枚数",
        "reason": "設定差はありますが設定1と6の一部数値しか公開されておらず全設定の尤度を作れません。さらに獲得枚数はAT展開の分散が大きいため推測Featureには不採用です。"
      },
      {
        "featureId": "REJ_ABYSS_LED_HINT",
        "name": "LEDの奇数/偶数/高設定示唆",
        "reason": "青・黄・緑は示唆方向のみで設定別出現率が公開されていないため数値推測には使いません。赤・紫・虹の設定下限/確定パターンだけEvidenceとして採用します。"
      },
      {
        "featureId": "REJ_ABYSS_END_HINT",
        "name": "AT終了画面の奇数/偶数/高設定示唆",
        "reason": "示唆方向のみの画面は設定別出現率がなく数値尤度を作れないため不採用です。設定否定・設定2/5/6・設定4以上・5以上・6の確定系はEvidenceとして採用します。"
      }
    ]
