        "requiredTrials": {
          "value": 15802,
          "unit": "総ゲーム"
        }
      },
      {
        "featureId": "FEAT_REG_COUNTER_EXCLUDED",
        "name": "データカウンターREG出現率",
        "reason": "REG出現率にも設定差がありますがデータカウンター値には連チャン中のREGが含まれ、通常時初当りの母集団と一致しません。初当りと同時採用した際の重複評価を避けるため不採用です。",
        "requiredTrials": {
          "value": 74431,
          "unit": "総ゲーム"
