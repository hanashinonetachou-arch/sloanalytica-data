    },
    {
      "blockId": "small-role-separate-overlap",
      "label": "チェリー・スイカの個別Runtime採用",
      "reason": "両方を同一ゲーム分母の独立Bernoulliとして重ねると排他関係を無視するため、現在は合算イベントとして採用する。",
      "reevaluationCondition": "implicit-residual categoricalをRuntime/UIで安全に扱える共通Contractが確立した場合"
    },
    {
      "blockId": "bonus-total-overlap",
      "label": "ボーナス合算のRuntime採用",
      "reason": "ボーナス成立ゲームは小役成立と重なり得るため、現行の独立尤度モデルで小役Featureと併用すると相関を二重に評価する可能性がある。設定別原分布は保存するがRuntime推測には使用しない。",
      "reevaluationCondition": "同時成立を含むjoint/conditional likelihoodをsource-supportedに表現できる共通Contractが確立した場合"
    }
