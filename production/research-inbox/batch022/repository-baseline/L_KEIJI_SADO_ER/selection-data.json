      "name": "通常ゲーム数",
      "type": "integer",
      "category": "PRIMARY",
      "unit": "G",
      "displayOrder": 1,
      "defaultValue": 0
    },
    {
      "id": "INP_INITIAL_COUNT",
      "name": "ボーナス・AT初当り回数",
      "type": "counter",
      "category": "PRIMARY",
      "unit": "回",
      "displayOrder": 2,
      "defaultValue": 0
    },
    {
      "id": "INP_SEATED_GAMES",
      "name": "着席時ゲーム数",
      "type": "integer",
      "category": "PREDECESSOR",
      "unit": "G",
      "displayOrder": 10,
      "description": "データカウンター仕様が公開AT初当り確率と合う場合のみ入力。",
      "defaultValue": "",
      "inferenceRole": "EXCLUDE"
    },
    {
      "id": "INP_SEATED_AT_COUNT",
      "name": "着席時AT初当り回数",
      "type": "counter",
      "category": "PREDECESSOR",
      "unit": "回",
      "displayOrder": 11,
      "defaultValue": "",
      "inferenceRole": "EXCLUDE"
    }
  ],
  "features": [
    {
      "researchFeatureId": "RF_INITIAL_COMBINED",
      "featureId": "FEAT_INITIAL_COMBINED",
      "adoptionCategory": "INCLUDE_PRIMARY",
      "numeratorInputId": "INP_INITIAL_COUNT",
      "denominatorInputId": "INP_NORMAL_GAMES",
      "minimumSample": 1,
      "sampleRecommendation": 5000,
      "weight": 1,
      "displayFormat": "ratio_1_over_n",
      "difficultyExposure": {
        "mode": "per_game",
        "factor": 1,
        "quality": "ESTIMATED",
        "basisId": "NORMAL_GAMES"
      },
      "difficultyParticipation": "INCLUDE",
      "userReason": "ボーナス+AT合算初当りが最も高頻度で追いやすいため主軸採用。"
    },
    {
      "researchFeatureId": "RF_AT_INITIAL",
      "featureId": "FEAT_AT_INITIAL",
      "adoptionCategory": "EXCLUDE",
      "rejectionReason": "AT初当りには設定差がありますが、合算初当りの部分集合で同じ当選情報を二重に数えることになります。さらにAT単体は試行数も少ないため、自分区間では高頻度な合算初当りを優先して不採用です。"
    },
    {
      "researchFeatureId": "RF_AT_PREDECESSOR",
      "featureId": "FEAT_AT_PREDECESSOR",
      "adoptionCategory": "EXCLUDE",
      "rejectionReason": "機種固有の着席時データの取得元と公開確率の試行区間との同値性が実機未確認のため、確認完了まで推測には使用しません。",
      "userReason": "着席時入力欄は記録用として残しますが、公開確率と同じ分母・分子の観測条件をデータカウンターから再現できることが実機で確定するまで、前任者Featureは推測不参加とします。"
    }
  ],
  "rejectedElements": [
    {
      "id": "REJECTED_STATE_TRANSITION",
      "name": "成立役別の内部状態移行抽選",
      "reason": "弱チェリー・スイカなどからの状態移行に設定差がありますが、通常・高確・超高確を完全に観測できません。状態誤認を含む母数は設定差より大きな偏りを作り得るため不採用です。"
    },
    {
      "id": "REJECTED_STATE_INITIAL_HIT",
      "name": "内部状態別の成立役初当り抽選",
      "reason": "高確中の強レア役などに大きな設定差がありますが、前提となる内部状態を確実に分類できません。条件付き確率の分母を正しく作れないため、合算初当りへ集約しています。"
    },
    {
      "id": "REJECTED_TSUKIMIZAKE_DIRECT",
      "name": "月見酒ボーナス経由の前兆ステージからのAT直撃",
      "reason": "設定差があるとされていますが、月見酒ボーナス経由という限定条件で試行機会が少なく、1日の実戦で安定した母数を作りにくいため数値Featureにはしていません。"
    }
  ],
