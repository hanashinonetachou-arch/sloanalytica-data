        "basisId": "NORMAL_GAMES"
      },
      "difficultyParticipation": "INCLUDE",
      "userReason": "ART初当りの設定差が大きいため主軸採用。"
    },
    {
      "researchFeatureId": "RF_ART_PREDECESSOR",
      "featureId": "FEAT_ART_PREDECESSOR",
      "adoptionCategory": "EXCLUDE",
      "rejectionReason": "着席時データカウンターのART初当り回数・累計ゲーム数が、公開ART初当り確率と同じ試行母集団を表すことを実機で確認できていないため、現版では推測に使用しない。実機確認後に再評価する。"
    },
    {
      "researchFeatureId": "RF_COMMON_COIN",
      "featureId": "FEAT_COMMON_COIN",
      "adoptionCategory": "INCLUDE_SUPPORT",
      "numeratorInputId": "INP_COMMON_COIN",
      "denominatorInputId": "INP_ROLE_GAMES",
      "minimumSample": 1,
      "sampleRecommendation": 3000,
      "weight": 1,
      "displayFormat": "ratio_1_over_n",
      "difficultyParticipation": "EXCLUDE",
      "userReason": "共通コインは高頻度で設定差があり、実機連動機能またはART中ナビなしベルで観測できるため採用。",
      "difficultyExclusionReason": "専用の小役集計ゲーム数と設定帯判別Gの対応率を公開情報から一意に導出できないため、ゲーム数ベースDifficultyから除外。推測計算には採用する。"
    },
    {
      "researchFeatureId": "RF_DOKOMAJI",
      "featureId": "FEAT_DOKOMAJI",
      "adoptionCategory": "INCLUDE_SUPPORT",
      "numeratorInputId": "INP_DOKOMAJI_COUNT",
      "denominatorInputId": "INP_DOKOMAJI_ELIGIBLE_BONUS",
      "minimumSample": 1,
      "sampleRecommendation": 10,
      "weight": 0.5,
      "displayFormat": "percent",
      "difficultyParticipation": "EXCLUDE",
      "userReason": "どこまじは設定1の1.6%から設定6の23.4%まで大差がある。超高確・ART中・朝一30G程度を除外して補助採用する。ただし内部当選しても演出が必ず出るわけではないため重み0.5とする。",
      "difficultyExclusionReason": "観測率を1500/3000/7000Gへ安定換算できないためDifficultyには含めない。"
    },
    {
      "researchFeatureId": "RF_REG_REQUIRED_KILLS",
      "featureId": "FEAT_REG_REQUIRED_KILLS",
      "adoptionCategory": "INCLUDE_SUPPORT",
      "numeratorInputId": "INP_REG_THRESHOLD_25",
      "categoryInputIds": [
        "INP_REG_THRESHOLD_50",
        "INP_REG_THRESHOLD_75",
        "INP_REG_THRESHOLD_100"
      ],
      "denominatorInputIds": [
        "INP_REG_THRESHOLD_25",
        "INP_REG_THRESHOLD_50",
        "INP_REG_THRESHOLD_75",
        "INP_REG_THRESHOLD_100"
      ],
      "inputTransform": "sum_inputs_to_trials",
      "minimumSample": 1,
      "sampleRecommendation": 5,
      "weight": 0.8,
      "difficultyParticipation": "EXCLUDE",
      "userReason": "殲滅ボーナスの規定撃破数は25・50体を中心に設定差が非常に大きく、少数回でも情報量が高い。一撃フラグやレア役多数などで規定数を一意に特定できない回だけ除外して補助採用する。",
      "difficultyExclusionReason": "殲滅ボーナス回数と判別不能率を通常ゲーム数へ安定換算できないためDifficultyには含めない。"
    }
  ],
  "rejectedElements": [
    {
      "id": "REJECTED_BONUS_RATE",
      "name": "ボーナス確率・特定ボーナス確率",
      "reason": "設定差はありますが、ART初当りやどこまじと同じボーナス経路の情報を多く共有します。契機別まで細分化すると1日の各カテゴリ試行も少なくなるため、現構成では独立尤度として重ねず不採用です。"
    },
    {
      "id": "REJECTED_REPLAY_BONUS",
      "name": "リプレイ＋ボーナス同時当選期待度",
      "reason": "設定差は0.7%〜1.0%と小さく、1日実戦で得られる試行数では設定間の差に対して標本誤差が大きくなりやすいため、独立Featureとしての追加情報量が限定的で不採用です。"
    },
    {
      "id": "REJECTED_COIN_BASE",
      "name": "50枚あたりのゲーム数",
      "reason": "高設定ほど高ベースですが、主因は採用済みの共通コイン確率です。同じコイン持ち情報を二重計上するため独立Featureにはしません。"
    },
    {
      "id": "REJECTED_MAJICHAN_RATE",
      "name": "まじかるちゃんす発生率（状態・契機別）",
      "reason": "大きな設定差を持つ条件がありますが、低確/通常/高確など内部状態とボーナス契機を正確に分類する必要があります。状態誤認を含む母数は尤度を大きく歪めるため、現時点では観測条件を絞れる『どこまじ』を優先しています。"
    },
    {
      "id": "REJECTED_NORMAL_MODE",
      "name": "詠唱チャレンジ終了時の通常モード抽選",
      "reason": "ART当選有無など条件別に設定差がありますが、選択された内部モードそのものを直接観測できません。結果からモードを推定して再び設定推測へ使う循環を避けるため不採用です。"
    },
    {
      "id": "REJECTED_ENCOUNTER_ZONE",
      "name": "エンカウントゾーン出現率",
      "reason": "設定差はありますが発生機会が限定され、1日で十分な独立試行を得にくい要素です。ART初当り・共通コイン・規定撃破数など、より直接かつ高情報量の要素を優先します。"
    }
  ],
