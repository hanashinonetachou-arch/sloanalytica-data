  "features": [
    {
      "researchFeatureId": "RF_ART_INITIAL",
      "featureId": "FEAT_ART_INITIAL",
      "adoptionCategory": "INCLUDE_PRIMARY",
      "numeratorInputId": "INP_ART_COUNT",
      "denominatorInputId": "INP_NORMAL_GAMES",
