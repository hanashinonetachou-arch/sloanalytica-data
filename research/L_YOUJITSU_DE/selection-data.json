  "features":[
    {"researchFeatureId":"RF_CZ_INITIAL","featureId":"FEAT_CZ_INITIAL","adoptionCategory":"INCLUDE_PRIMARY","minimumSample":300,"sampleRecommendation":5000,"weight":1,"numeratorInputId":"INP_CZ_INITIAL","denominatorInputId":"INP_NORMAL_GAMES","difficultyParticipation":"INCLUDE","difficultyExposure":{"mode":"per_game","factor":1,"quality":"EXACT","basisId":"NORMAL_GAMES"},"userReason":"通常ゲームを分母にしたCZ初当りは全設定値が揃い、AT初当りより発生頻度と設定1対6の1G当たり識別情報が大きいため主Featureとして採用します。"},
    {"researchFeatureId":"RF_AT_INITIAL","featureId":"FEAT_AT_INITIAL_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"AT初当りはCZ成功など下流経路を含み、CZ初当りと同じ通常ゲームから独立二項尤度で評価すると遊技経路を重複評価するため不採用です。"},
    {"researchFeatureId":"RF_RED_PUSH_ON_SUCCESS","featureId":"FEAT_RED_PUSH_ON_SUCCESS","adoptionCategory":"INCLUDE_SUPPORT","minimumSample":10,"sampleRecommendation":100,"weight":1,"numeratorInputId":"INP_RED_PUSH","denominatorInputId":"INP_RED_PUSH_SUCCESS_TRIALS","difficultyParticipation":"EXCLUDE","userReason":"連続演出成功後の赤PUSH出現という条件付き確率で、成功回数を分母に分離して観測できるため補助Featureとして採用します。","difficultyExclusionReason":"通常ゲーム数から連続演出成功回数を正確に導出できないため共通Difficultyでは除外します。"},
    {"researchFeatureId":"RF_CZ_SUCCESS_DAXEL_FLASH","featureId":"FEAT_CZ_SUCCESS_DAXEL_FLASH","adoptionCategory":"INCLUDE_SUPPORT","minimumSample":10,"sampleRecommendation":100,"weight":1,"numeratorInputId":"INP_DAXEL_FLASH","denominatorInputId":"INP_CZ_SUCCESS_TRIALS","difficultyParticipation":"EXCLUDE","userReason":"CZ成功を条件としたダクセルフラッシュ出現率で、CZ成功回数という専用分母により総CZ初当りとは別の条件付き情報として評価できるため採用します。","difficultyExclusionReason":"通常ゲーム数からCZ成功試行数を厳密に導出できないため共通Difficultyでは除外します。"},
    {"researchFeatureId":"RF_PERIODIC_CZ_TYPE","featureId":"FEAT_PERIODIC_CZ_TYPE","adoptionCategory":"INCLUDE_SUPPORT","minimumSample":5,"sampleRecommendation":50,"weight":1,"numeratorInputId":"INP_PERIODIC_GIRLS","denominatorInputId":"INP_PERIODIC_CZ_TOTAL","categoryInputIds":["INP_PERIODIC_JITSURYOKU"],"difficultyParticipation":"EXCLUDE","userReason":"特定周期でCZ当選した後のCZ種別という条件付き完全分布で、対象CZ回数を専用分母として総CZ初当りとは分離できるため補助Featureとして採用します。","difficultyExclusionReason":"通常ゲーム数から対象周期CZ当選回数を厳密に導出できないため共通Difficultyでは除外します。"},
    {"researchFeatureId":"RF_CZ_MODE3_WATERMELON","featureId":"FEAT_CZ_MODE3_WATERMELON_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"CZモード3という内部状態の成立役別CZ当選は総CZ初当りの条件付き部分集合で、モード3滞在試行を確実に識別できないため独立評価せず不採用です。"},
    {"researchFeatureId":"RF_CZ_MODE3_WEAK_CHANCE","featureId":"FEAT_CZ_MODE3_WEAK_CHANCE_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"CZモード3の内部状態を正確に観測できず、総CZ初当りの部分集合でもあるため、弱チャンス目契機を独立尤度として二重評価しないよう不採用です。"},
    {"researchFeatureId":"RF_CZ_MODE3_WEAK_CHERRY","featureId":"FEAT_CZ_MODE3_WEAK_CHERRY_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"CZモード3の内部状態を正確に観測できず、総CZ初当りの部分集合でもあるため、弱チェリー契機を独立尤度として二重評価しないよう不採用です。"},
    {"researchFeatureId":"RF_BONUS_END_SCREEN","featureId":"FEAT_BONUS_END_SCREEN","adoptionCategory":"INCLUDE_SUPPORT","minimumSample":5,"sampleRecommendation":50,"weight":1,"numeratorInputId":"INP_BONUS_END_KUSHIDA","denominatorInputId":"INP_BONUS_END_TRIALS","difficultyParticipation":"EXCLUDE","userReason":"よう実BONUS終了を分母に櫛田桔梗の出現を直接観測でき、通常時CZ率とは異なる条件付き演出確率なので補助Featureとして採用します。","difficultyExclusionReason":"通常ゲーム数からよう実BONUS終了回数を正確に導出できないため共通Difficultyでは除外します。"}
