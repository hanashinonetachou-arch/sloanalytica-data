  "features":[
    {"researchFeatureId":"RF_BONUS_INITIAL","featureId":"FEAT_BONUS_INITIAL_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"ボーナス初当りは小役成立や役別ボーナス当選を下流に含むため、設定差のある弱チェリーと独立二項尤度で同時評価すると同じ因果経路を再利用するため不採用です。"},
    {"researchFeatureId":"RF_AT_INITIAL","featureId":"FEAT_AT_INITIAL_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"AT初当りは通常時の小役・ボーナス・CZ等の下流結果を集約するため、設定差小役と併用した際の因果重複を避けて不採用です。"},
    {"researchFeatureId":"RF_WEAK_CHERRY","featureId":"FEAT_WEAK_CHERRY","adoptionCategory":"INCLUDE_PRIMARY","minimumSample":500,"sampleRecommendation":5000,"weight":1,"numeratorInputId":"INP_WEAK_CHERRY","denominatorInputId":"INP_ALL_GAMES","difficultyParticipation":"INCLUDE","difficultyExposure":{"mode":"per_game","factor":1,"quality":"EXACT","basisId":"ALL_GAMES"},"userReason":"全状態ゲームを分母とする設定別確率が明確で発生頻度が高く、実機連動機能で自動カウント可能と確認されているため、誤分類の少ない主Featureとして採用します。"},
    {"researchFeatureId":"RF_WEAK_WAVE","featureId":"FEAT_WEAK_WAVE_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"弱チェリーと同じ全ゲーム分母上の排他的な小役カテゴリで、別々の二項尤度にすると非該当ゲームを重複評価するため、1G当たり識別情報がより大きい弱チェリーへ一本化します。"},
    {"researchFeatureId":"RF_REACH_REPLAY","featureId":"FEAT_REACH_REPLAY_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"弱チェリーと同じ全ゲーム分母上の小役カテゴリであるうえ約1/2048～1/2979と低頻度なため、非該当ゲームの二重評価を避けて不採用です。"},
    {"researchFeatureId":"RF_OTHER_TO_HIGH","featureId":"FEAT_OTHER_TO_HIGH_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"内部の通常滞在を識別し、『その他』成立という複合カテゴリの正しい試行数を数える必要があり、公開分母を実戦で安定再現できないため不採用です。"},
    {"researchFeatureId":"RF_NORMAL_WEAK_CHERRY_BONUS","featureId":"FEAT_NORMAL_WEAK_CHERRY_BONUS_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"弱チェリー成立を条件としたボーナス当選は総ボーナス初当りの部分集合で、弱チェリー頻度そのものとも因果的に連なるため二重評価防止で不採用です。"},
    {"researchFeatureId":"RF_NORMAL_WEAK_WAVE_BONUS","featureId":"FEAT_NORMAL_WEAK_WAVE_BONUS_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"弱波成立後のボーナス当選という総ボーナス初当りの部分集合で、成立役と下流当選を別々に再利用するため不採用です。"},
    {"researchFeatureId":"RF_NORMAL_CHANCE_BONUS","featureId":"FEAT_NORMAL_CHANCE_BONUS_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"チャンス目契機ボーナスは総ボーナス初当りの部分集合で、通常滞在という内部状態の正確な分母観測も必要なため不採用です。"},
    {"researchFeatureId":"RF_NORMAL_STRONG_CHERRY_BONUS","featureId":"FEAT_NORMAL_STRONG_CHERRY_BONUS_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"強チェリー契機ボーナスは総ボーナス初当りの部分集合で、成立役→ボーナスという下流経路を再利用するため独立Featureとしては不採用です。"},
    {"researchFeatureId":"RF_NORMAL_STRONG_WAVE_BONUS","featureId":"FEAT_NORMAL_STRONG_WAVE_BONUS_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"強波契機ボーナスは総ボーナス初当りの部分集合で、成立役→ボーナスという下流経路を再利用するため独立Featureとしては不採用です。"},
    {"researchFeatureId":"RF_HIGH_WEAK_WAVE_BONUS","featureId":"FEAT_HIGH_WEAK_WAVE_BONUS_EXCLUDED","adoptionCategory":"EXCLUDE","userFacingReason":"高確中弱波契機ボーナスは総ボーナス初当りの部分集合で、さらに高確滞在の正確な識別が必要なため、分母誤分類と二重評価を避けて不採用です。"}
