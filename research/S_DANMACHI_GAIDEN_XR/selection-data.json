  "features": [
    {
      "researchFeatureId": "RF_CZ_FIRST_HIT",
      "featureId": "FEAT_CZ_FIRST_HIT_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "CZ初当りはAT初当りの主要経路を形成し、両方を独立尤度として併用するとCZ経由の当選情報を二重評価するため不採用です。"
    },
    {
      "researchFeatureId": "RF_AT_FIRST_HIT",
      "featureId": "FEAT_AT_FIRST_HIT",
      "adoptionCategory": "INCLUDE_PRIMARY",
      "numeratorInputId": "INP_AT_FIRST_HIT",
      "denominatorInputId": "INP_NORMAL_GAMES",
      "weight": 1,
      "difficultyParticipation": "INCLUDE",
      "difficultyExposure": {
        "mode": "per_game",
        "factor": 1,
        "quality": "EXACT",
        "basisId": "NORMAL_GAMES"
      },
      "userReason": "AT初当りは通常ゲーム数を分母に直接観測でき、設定1の約1/379から設定6の約1/252まで一貫した設定差があるため主軸採用します。"
    },
    {
      "researchFeatureId": "RF_AT_DIRECT",
      "featureId": "FEAT_AT_DIRECT_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "CZ非経由AT直撃はAT初当りの部分集合で、AT初当りと独立Featureとして加えると同じAT当選を二重評価するため不採用です。"
    },
    {
      "researchFeatureId": "RF_STRONG_CHERRY",
      "featureId": "FEAT_STRONG_CHERRY_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "設定差はあるものの約1/400～1/328と低頻度で設定差も小さく、実戦範囲の必要試行量が長いため数値推測には不採用です。"
    },
    {
      "researchFeatureId": "RF_LOKI_MUSOU",
      "featureId": "FEAT_LOKI_MUSOU_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "約1/138～1/128と設定差が小さく、実戦サンプルで得られる追加情報量が乏しいため数値推測には不採用です。"
    }
  ],
