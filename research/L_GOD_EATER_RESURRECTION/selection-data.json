      "unit": "回",
      "displayOrder": 2,
      "defaultValue": 0
    }
  ],
  "features": [
    {
      "researchFeatureId": "RF_AT_INITIAL",
      "featureId": "FEAT_AT_INITIAL",
      "adoptionCategory": "INCLUDE_PRIMARY",
      "numeratorInputId": "INP_AT_INITIAL_COUNT",
      "denominatorInputId": "INP_AT_TRIAL_GAMES",
      "minimumSample": 1,
      "sampleRecommendation": 7000,
      "weight": 1,
      "displayFormat": "ratio_1_over_n",
      "difficultyExposure": {
        "mode": "per_game",
        "factor": 1,
        "quality": "ESTIMATED",
        "basisId": "AT_INITIAL_GAME_BASIS",
        "confidence": "LOW",
        "estimationBasis": "公開AT初当り確率をユーザー自身の通常実戦ゲーム基準へ接続する暫定Exposure。",
        "uncertaintyNote": "Difficulty用の実戦G換算は暫定。"
      },
      "difficultyParticipation": "INCLUDE",
      "userReason": "AT初当りは設定1の1/351.9から設定6の1/290.3まで段階差があり、継続観測しやすいため採用。"
    },
    {
      "researchFeatureId": "RF_CZ_COMBINED",
      "featureId": "FEAT_CZ_COMBINED",
      "adoptionCategory": "EXCLUDE",
      "rejectionReason": "CZはAT到達経路と依存し、AT初当りとの二重計上を避ける安全な分解を現状の公開値だけでは構成できない。",
      "userReason": "CZ合算はAT初当りとの経路依存を安全に分解できないため不採用。"
    },
    {
      "researchFeatureId": "RF_STRONG_CHERRY_AT",
      "featureId": "FEAT_STRONG_CHERRY_AT",
      "adoptionCategory": "EXCLUDE",
      "rejectionReason": "強チェリー直撃はAT初当りの部分集合で、そのまま併用すると同じAT当選を二重評価する。",
      "userReason": "強チェリー直撃は設定差が大きいがAT初当りの一部なので単独追加しない。"
    }
  ],
