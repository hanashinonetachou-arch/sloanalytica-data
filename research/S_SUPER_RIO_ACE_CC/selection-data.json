    },
    {
      "researchFeatureId": "RF_BONUS_AT_DRAW_WEAK",
      "featureId": "FEAT_BONUS_AT_DRAW_WEAK_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userReason": "設定差はあるものの、ボーナス中の弱レア役成立回数とその契機によるAT当選を正確に対応付ける必要があり、通常実戦での観測負担が大きいため不採用です。"
    },
    {
      "researchFeatureId": "RF_BONUS_AT_DRAW_STRONG",
      "featureId": "FEAT_BONUS_AT_DRAW_STRONG_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userReason": "設定差は比較的大きいものの、強レア役成立とAT当選の因果判別が必要でサンプルも少ないため、通常入力には採用しません。"
    }
