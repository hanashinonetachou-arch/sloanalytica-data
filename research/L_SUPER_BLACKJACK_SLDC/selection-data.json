  "features": [
    {
      "researchFeatureId": "RF_BONUS_FIRST_HIT",
      "featureId": "FEAT_BONUS_FIRST_HIT",
      "adoptionCategory": "INCLUDE_PRIMARY",
      "numeratorInputId": "INP_BONUS_FIRST_HIT",
      "denominatorInputId": "INP_NORMAL_GAMES",
      "weight": 1,
      "difficultyParticipation": "INCLUDE",
      "difficultyExposure": {
        "mode": "per_game",
        "factor": 1,
        "quality": "EXACT",
        "basisId": "NORMAL_GAMES"
      },
      "userReason": "ボーナス初当りは通常ゲーム数を分母に直接観測でき、設定4以上で明確に上昇するため主軸採用します。"
    },
    {
      "researchFeatureId": "RF_DIAGONAL_SUIKA",
      "featureId": "FEAT_DIAGONAL_SUIKA",
      "adoptionCategory": "INCLUDE_SUPPORT",
      "numeratorInputId": "INP_DIAGONAL_SUIKA",
      "denominatorInputId": "INP_TOTAL_GAMES",
      "weight": 1,
      "difficultyParticipation": "INCLUDE",
      "difficultyExposure": {
        "mode": "per_game",
        "factor": 1,
        "quality": "EXACT",
        "basisId": "TOTAL_GAMES"
      },
      "userReason": "斜めスイカは成立回数を直接観測でき、設定1約1/99.9から設定6約1/83.9まで設定差があるため補助採用します。"
    },
    {
      "researchFeatureId": "RF_SUIKA_ST_DIRECT",
      "featureId": "FEAT_SUIKA_ST_DIRECT_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "斜めスイカからのST直撃は斜めスイカ成立の条件付き部分事象で、斜めスイカFeatureと独立に加えると同一小役情報を重ねて評価するため不採用です。"
    },
    {
      "researchFeatureId": "RF_CHANCE_BONUS_DIRECT",
      "featureId": "FEAT_CHANCE_BONUS_DIRECT_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "チャンス目からのボーナス直撃はボーナス初当りの部分集合で、主軸初当りと独立に加えると同じボーナス当選を二重評価するため不採用です。"
    },
    {
      "researchFeatureId": "RF_BONUS_HIGH_ENTRY",
      "featureId": "FEAT_BONUS_HIGH_ENTRY_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "ボーナス高確は初当りへ至る内部経路で、滞在・移行状態を独立に積むとボーナス初当りの原因側を重ねて評価するため不採用です。"
    },
    {
      "researchFeatureId": "RF_BONUS_HIGH_EXPECTATION",
      "featureId": "FEAT_BONUS_HIGH_EXPECTATION_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "ボーナス高確中の当選期待度はボーナス初当り経路の条件付き結果で、主軸初当りと強く依存するため不採用です。"
    },
    {
      "researchFeatureId": "RF_CHANCE_TO_BONUS_HIGH",
      "featureId": "FEAT_CHANCE_TO_HIGH_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "チャンス目からの高確移行はボーナス初当りの原因側となる中間事象で、主軸初当りと別尤度にすると経路を重複評価するため不採用です。"
    },
    {
      "researchFeatureId": "RF_RIO_HIGH",
      "featureId": "FEAT_RIO_HIGH_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "RC高確はボーナス・STへつながる内部経路で、初当り系Featureと独立に積むと同じ当選過程の情報を重ねるため不採用です。"
    },
    {
      "researchFeatureId": "RF_BB_THROUGH_MAX",
      "featureId": "FEAT_BB_THROUGH_MAX_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "最大規定スルー回数は内部で選ばれる潜在値で、実際に早く当選した場合は選択された最大回数を直接観測できないため不採用です。"
    },
    {
      "researchFeatureId": "RF_STOCK_TIME",
      "featureId": "FEAT_STOCK_TIME_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "設定差候補ですが設定2～6の具体確率がResearchで未解決で、全設定の尤度を構成できないため不採用です。"
    },
    {
      "researchFeatureId": "RF_JOKER_MODE",
      "featureId": "FEAT_JOKER_MODE_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "設定1以外の具体確率がResearchで未解決で、全設定の尤度を構成できないため不採用です。"
    },
    {
      "researchFeatureId": "RF_JAC_CARD",
      "featureId": "FEAT_JAC_CARD_EXCLUDED",
      "adoptionCategory": "EXCLUDE",
      "userFacingReason": "トランプのカテゴリ別回数は観測できますが、設定別の完全な出現分布が未解決でmultinomial尤度を構成できないため不採用です。"
    }
  ],
