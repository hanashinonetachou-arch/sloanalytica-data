      "displayOrder": 2,
      "defaultValue": 0
    },
    {
      "id": "INP_SEATED_GAMES",
      "name": "着席時ゲーム数",
      "type": "integer",
      "category": "PREDECESSOR",
      "unit": "G",
      "displayOrder": 10,
      "description": "着席時にデータカウンターで確認した累計ゲーム数です。店舗・カウンター仕様がBB中を通常ゲームとして加算するなど、公開BB初当り確率の分母と合わないと判断した場合は入力しないでください。",
      "defaultValue": 0,
      "inferenceRole": "EXCLUDE"
    },
    {
      "id": "INP_SEATED_BB_COUNT",
      "name": "着席時バトルボーナス初当り回数",
      "type": "counter",
      "category": "PREDECESSOR",
      "unit": "回",
      "displayOrder": 11,
      "description": "着席時にデータカウンターで確認したBB初当り回数を入力します。",
      "defaultValue": 0,
      "inferenceRole": "EXCLUDE"
    },
    {
      "id": "INP_ROLE_GAMES",
      "name": "小役集計ゲーム数",
      "type": "integer",
      "category": "ROLE",
      "unit": "G",
      "displayOrder": 20,
      "description": "実機連動機能推奨。遊技データと同じ集計区間のゲーム数を入力してください。",
      "defaultValue": 0
    },
    {
      "id": "INP_WATERMELON_COUNT",
      "name": "スイカ合算回数",
      "type": "counter",
      "category": "ROLE",
      "unit": "回",
      "displayOrder": 21,
      "description": "実機連動機能推奨。遊技データで確認できる弱・強スイカの合算回数を入力してください。",
      "defaultValue": 0
    },
    {
      "id": "INP_BB_END_VOICE_TRIALS",
      "name": "ボイス確認回数",
      "type": "counter",
      "category": "BB_END_VOICE",
      "unit": "回",
      "displayOrder": 30,
      "description": "1G連非当選だったBB終了時にサブ液晶をタッチしてボイスを確認した回数です。1G連当選時は含めません。",
      "defaultValue": 0
    },
