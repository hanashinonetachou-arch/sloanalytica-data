  "features": [
    {
      "researchFeatureId": "RF_AT_INITIAL",
      "featureId": "FEAT_AT_INITIAL",
      "adoptionCategory": "INCLUDE_PRIMARY",
      "weight": 1,
      "numeratorInputId": "INP_AT_INITIAL_COUNT",
      "denominatorInputId": "INP_AT_INITIAL_TRIALS",
      "userReason": "AT初当りの対象となる通常時ゲームを分母とし、同じ観測経路の分子と組み合わせる。",
      "difficultyParticipation": "EXCLUDE",
      "difficultyExclusionReason": "UI構築構築時点では実戦総Gへの観測量換算を別監査するため、Difficulty校正へはまだ参加させない。"
    },
    {
      "researchFeatureId": "RF_REF_EMERGENCY_QUEST",
      "featureId": "FEAT_EMERGENCY_QUEST_DESTROYER",
      "adoptionCategory": "INCLUDE_SUPPORT",
      "weight": 0.6,
      "numeratorInputId": "INP_DESTROYER_COUNT",
      "denominatorInputId": "INP_EMERGENCY_QUEST_TOTAL",
      "userReason": "デストロイヤー選択率に大きな設定差があり、対戦相手を実戦中に明確に数えられるため補助判別として採用。少数回では振れが大きいため、20回程度から参考度が上がり、30回以上を一つの目安とする。",
      "difficultyParticipation": "EXCLUDE"
    },
    {
      "researchFeatureId": "RF_REF_QUEST_RANK_SUCCESS",
      "featureId": "FEAT_REF_QUEST_RANK_SUCCESS",
      "adoptionCategory": "EXCLUDE",
      "weight": 1,
      "userFacingReason": "0〜39pt・40〜59pt・60〜79ptでは成功率に設定差がある一方、80pt以上には設定差がありません。また連続演出中の書き換え当選を区別しないと、ランク到達時の抽選だけを正しく数えられません。現状の入力仕様では各ランク帯の対象回数と書き換えを一貫して分離記録できないため不採用。",
      "rejectionReason": "0〜39pt・40〜59pt・60〜79ptでは成功率に設定差がある一方、80pt以上には設定差がありません。また連続演出中の書き換え当選を区別しないと、ランク到達時の抽選だけを正しく数えられません。現状の入力仕様では各ランク帯の対象回数と書き換えを一貫して分離記録できないため不採用。",
      "difficultyParticipation": "EXCLUDE"
    },
    {
      "researchFeatureId": "RF_REF_BATH_INITIAL_POINTS",
      "featureId": "FEAT_REF_BATH_INITIAL_POINTS",
      "adoptionCategory": "EXCLUDE",
      "weight": 1,
      "userFacingReason": "初期2〜5ptの振り分けには設定差がありますが、大半を占める2ptの差は小さく、差が目立つ4pt・5ptは低頻度です。さらに対象となるお風呂ゾーンを漏れなく同じ条件で数える必要があるため、現状の入力仕様では安定した推測材料として扱いにくく不採用。",
      "rejectionReason": "初期2〜5ptの振り分けには設定差がありますが、大半を占める2ptの差は小さく、差が目立つ4pt・5ptは低頻度です。さらに対象となるお風呂ゾーンを漏れなく同じ条件で数える必要があるため、現状の入力仕様では安定した推測材料として扱いにくく不採用。",
      "difficultyParticipation": "EXCLUDE"
    },
    {
      "researchFeatureId": "RF_REF_BONUS_7_ALIGN",
      "featureId": "FEAT_REF_BONUS_7_ALIGN",
      "adoptionCategory": "EXCLUDE",
      "weight": 1,
      "userFacingReason": "条件付き試行の完全な分母取得が未確立のため数値推測には採用しない。",
      "rejectionReason": "条件付き試行の完全な分母取得が未確立のため数値推測には採用しない。",
      "difficultyParticipation": "EXCLUDE"
    },
    {
      "researchFeatureId": "RF_REF_HIDDEN_MODE",
      "featureId": "FEAT_REF_HIDDEN_MODE",
      "adoptionCategory": "EXCLUDE",
      "weight": 1,
      "userFacingReason": "内部状態を確定観測できないため数値推測には採用しない。",
      "rejectionReason": "内部状態を確定観測できないため数値推測には採用しない。",
      "difficultyParticipation": "EXCLUDE"
    }
